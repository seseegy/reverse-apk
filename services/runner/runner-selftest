#!/usr/bin/env python3
"""Uji mandiri image runner. Keluar dengan kode != 0 bila ada pemeriksaan yang gagal.

Dijalankan lewat `make runner-selftest`, yang memakai opsi isolasi yang sama dengan job asli
(--network none, --read-only, cap-drop ALL, dst).
"""

import os
import socket
import subprocess
import sys

failed = False


def report(ok: bool, name: str, detail: str = "") -> None:
    global failed
    failed = failed or not ok
    print(f"[{'OK ' if ok else 'GAGAL'}] {name}" + (f" — {detail}" if detail else ""))


def version(cmd: list[str]) -> str:
    out = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    text = (out.stdout or out.stderr).strip().splitlines()
    return text[0] if text else f"(kode {out.returncode})"


os.makedirs(os.environ.get("HOME", "/tmp/home"), exist_ok=True)

# 1. Alat terpasang dan bisa dijalankan
for label, cmd in (
    ("java", ["java", "-version"]),
    ("jadx", ["jadx", "--version"]),
    ("apktool", ["apktool", "--version"]),
):
    try:
        report(True, label, version(cmd))
    except Exception as exc:  # noqa: BLE001
        report(False, label, f"{type(exc).__name__}: {exc}")

# 2. Bukan root
report(os.geteuid() != 0, "bukan root", f"uid={os.geteuid()}")

# 3. Rootfs di-mount read-only. Dibaca dari opsi mount, BUKAN dengan mencoba menulis:
#    user non-root memang tidak boleh menulis ke / walau rootfs-nya read-write.
root_opts = None
with open("/proc/self/mountinfo") as fh:
    for line in fh:
        parts = line.split()
        if len(parts) > 5 and parts[4] == "/":
            root_opts = parts[5].split(",")
            break
report(root_opts is not None and "ro" in root_opts, "rootfs read-only",
       "mount / opsi: " + (",".join(root_opts) if root_opts else "tidak ditemukan"))

# 3b. /tmp (tmpfs) harus bisa ditulis, karena jadx/apktool memakainya
try:
    probe = os.path.join(os.environ.get("HOME", "/tmp/home"), "probe")
    with open(probe, "w"):
        pass
    os.remove(probe)
    report(True, "/tmp dapat ditulis", "tmpfs tersedia untuk kerja alat")
except OSError as exc:
    report(False, "/tmp dapat ditulis", str(exc))

# 4. Jaringan terisolasi: koneksi keluar HARUS gagal
reachable = False
for host in ("1.1.1.1", "8.8.8.8"):
    try:
        with socket.create_connection((host, 443), timeout=3):
            reachable = True
            break
    except OSError:
        pass
report(not reachable, "jaringan terisolasi", "koneksi keluar gagal (benar)" if not reachable else "internet TERJANGKAU")

sys.exit(1 if failed else 0)
