#!/usr/bin/env python3
"""Uji mandiri image runner. Keluar dengan kode != 0 bila ada pemeriksaan yang gagal.

Dijalankan lewat `make runner-selftest`, yang memakai opsi isolasi yang sama dengan job asli
(--network none, --read-only, cap-drop ALL, dst).
"""

import hashlib
import os
import re
import shutil
import socket
import subprocess
import sys

failed = False


def report(ok: bool, name: str, detail: str = "") -> None:
    global failed
    failed = failed or not ok
    print(f"[{'OK ' if ok else 'GAGAL'}] {name}" + (f" — {detail}" if detail else ""))


def version(cmd: list[str]) -> str:
    out = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    text = (out.stdout or out.stderr).strip().splitlines()
    return text[0] if text else f"(kode {out.returncode})"


def diagnose(text: str) -> str:
    """Ringkasan galat yang menyimpan AKAR MASALAH. Ekor stack trace ('at ...ProcessImpl.start', '... 5 more') menyesatkan: yang berguna
    adalah baris 'Caused by:' (pertama dan terdalam), baris 'error=', dan awal keluaran yang bermakna (bukan baris 'at ...')."""
    lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
    if not lines:
        return "(tanpa keluaran)"
    causes = [ln for ln in lines if "Caused by:" in ln]
    picked = []
    for ln in (causes[:1] + causes[-1:] + [ln for ln in lines if "error=" in ln][:1]):
        if ln[:250] not in picked:
            picked.append(ln[:250])
    meaningful = [ln for ln in lines if not ln.startswith("at ") and not re.fullmatch(r"\.\.\. \d+ more", ln)]
    head = " | ".join(meaningful)[:300]
    return ("penyebab: " + " >> ".join(picked) + "; " if picked else "") + "keluaran: " + head


os.makedirs(os.environ.get("HOME", "/tmp/home"), exist_ok=True)

RUNNER_UID = 10001
MAX_EXEC_BYTES = 16 * 1024 * 1024  # tmpfs exec khusus sengaja kecil (compose: size=16m)
exec_dir = os.environ.get("AAPT2_EXEC_DIR", "/opt/aapt-exec")

# 1. Alat terpasang dan bisa dijalankan
for label, cmd in (
    ("java", ["java", "-version"]),
    ("keytool", ["keytool", "-version"]),
    ("jadx", ["jadx", "--version"]),
    ("apktool", ["apktool", "--version"]),
):
    try:
        report(True, label, version(cmd))
    except Exception as exc:  # noqa: BLE001
        report(False, label, f"{type(exc).__name__}: {exc}")

# 2. Bukan root
report(os.geteuid() != 0, "bukan root", f"uid={os.geteuid()}")

# 3. Rootfs di-mount read-only. Dibaca dari opsi mount, BUKAN dengan mencoba menulis:
#    user non-root memang tidak boleh menulis ke / walau rootfs-nya read-write.
root_opts = None
with open("/proc/self/mountinfo") as fh:
    for line in fh:
        parts = line.split()
        if len(parts) > 5 and parts[4] == "/":
            root_opts = parts[5].split(",")
            break
report(root_opts is not None and "ro" in root_opts, "rootfs read-only",
       "mount / opsi: " + (",".join(root_opts) if root_opts else "tidak ditemukan"))

# 3b. /tmp (tmpfs) harus bisa ditulis, karena jadx/apktool memakainya
try:
    probe = os.path.join(os.environ.get("HOME", "/tmp/home"), "probe")
    with open(probe, "w"):
        pass
    os.remove(probe)
    report(True, "/tmp dapat ditulis", "tmpfs tersedia untuk kerja alat")
except OSError as exc:
    report(False, "/tmp dapat ditulis", str(exc))

# 3c. /tmp runner HARUS noexec: invarian yang SENGAJA dijaga (runner memproses APK tak tepercaya; pertahanan berlapis). Docker memasang tmpfs sebagai
#     noexec secara bawaan. Bug `apktool b` (apktool mengekstrak aapt2 ke /tmp lalu menjalankannya) diperbaiki dengan salinan aapt2 di tmpfs khusus
#     /opt/aapt-exec (cek 6b), BUKAN dengan `exec` pada /tmp. Dibaca dari opsi mount DAN dibuktikan dengan percobaan exec sungguhan.
tmp_opts = None
with open("/proc/self/mountinfo") as fh:
    for line in fh:
        parts = line.split()
        if len(parts) > 5 and parts[4] == "/tmp":
            tmp_opts = parts[5].split(",")
probe_bin = f"/tmp/exec-probe-{os.getpid()}"
denied = False
try:
    shutil.copy("/bin/true", probe_bin)
    os.chmod(probe_bin, 0o755)
    subprocess.run([probe_bin], timeout=10)
except PermissionError:
    denied = True
except OSError as exc:  # noqa: BLE001
    print(f"    (percobaan exec di /tmp tidak meyakinkan: {type(exc).__name__}: {exc})")
finally:
    try:
        os.remove(probe_bin)
    except OSError:
        pass
report(tmp_opts is not None and "noexec" in tmp_opts and denied, "tmp runner noexec",
       "mount /tmp: " + (",".join(tmp_opts) if tmp_opts else "bukan mount sendiri") + "; exec dari /tmp " + ("ditolak (benar, disengaja)" if denied else "DIIZINKAN"))

# 4. Jaringan terisolasi: koneksi keluar HARUS gagal
reachable = False
for host in ("1.1.1.1", "8.8.8.8"):
    try:
        with socket.create_connection((host, 443), timeout=3):
            reachable = True
            break
    except OSError:
        pass
report(not reachable, "jaringan terisolasi", "koneksi keluar gagal (benar)" if not reachable else "internet TERJANGKAU")

# 5. Tool benar-benar bisa BEKERJA di rootfs read-only (bukan sekadar `--version`).
#    Regresi M0: JVM mengabaikan $HOME dan memakai home dari /etc/passwd (read-only), sehingga dekompilasi
#    sungguhan gagal padahal `--version` lolos. Di sini kedua tool dijalankan pada arsip sampah; galat yang
#    DIHARAPKAN adalah galat parsing, bukan galat lingkungan.
import tempfile
import zipfile

ENV_ERRORS = ("Read-only file system", "Could not create framework directory", "Failed to init common directories")
work = tempfile.mkdtemp(prefix="selftest-", dir=os.environ.get("HOME", "/tmp/home"))
junk = os.path.join(work, "junk.apk")
with zipfile.ZipFile(junk, "w") as zf:
    zf.writestr("AndroidManifest.xml", b"\x00junk" * 20)
    zf.writestr("classes.dex", b"dex\n035\x00" + b"\xff" * 64)
tool_env = {
    "PATH": os.environ.get("PATH", ""),
    "HOME": work,
    "JADX_OPTS": f"-Xmx512m -Duser.home={work} -Djava.io.tmpdir=/tmp",
}
for label, cmd in (
    ("apktool dapat bekerja", ["apktool", "d", "-f", "-o", os.path.join(work, "o1"), junk]),
    ("jadx dapat bekerja", ["jadx", "-d", os.path.join(work, "o2"), junk]),
):
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=120, env=tool_env, stdin=subprocess.DEVNULL)
        text = out.stdout + out.stderr
        bad = [e for e in ENV_ERRORS if e in text]
        report(not bad, label, "tidak ada galat lingkungan" if not bad else "galat lingkungan: " + ", ".join(bad))
    except Exception as exc:  # noqa: BLE001
        report(False, label, f"{type(exc).__name__}: {exc}")

# 6a. aapt2 SUMBER terpasang di rootfs (/opt/apktool/aapt2): ELF x86-64, milik root, bisa dieksekusi, TIDAK bisa ditulis runner, SHA-256 cocok pin
#     (ENV image AAPT2_SHA256; tidak disalin ke skrip). Sumber ini TIDAK diberikan langsung ke apktool: `File.setExecutable(true)` (AaptManager) memanggil chmod(2) dan
#     ditolak di rootfs read-only milik root. Wrapper `apktool` menyalinnya ke /opt/aapt-exec (cek 6b/6c) dan menyisipkan `--aapt` ke salinan itu untuk `b`.
aapt2 = os.environ.get("AAPT2_PATH", "/opt/apktool/aapt2")
pin = os.environ.get("AAPT2_SHA256", "")
try:
    with open(aapt2, "rb") as fh:
        data = fh.read()
    sha = hashlib.sha256(data).hexdigest()
    st = os.stat(aapt2)
    elf = data[:4] == b"\x7fELF" and data[4] == 2 and data[18:20] == b"\x3e\x00"  # ELF64, e_machine = x86-64
    problems = [msg for bad, msg in (
        (not elf, "bukan ELF 64-bit x86-64"),
        (not os.access(aapt2, os.X_OK), "tidak bisa dieksekusi"),
        (st.st_uid != 0 or os.access(aapt2, os.W_OK), "bukan milik root atau bisa ditulis runner"),
        (aapt2.startswith("/tmp/"), "berada di /tmp"),
        (not re.fullmatch(r"[0-9a-f]{64}", pin), "AAPT2_SHA256 tidak ada di ENV image"),
        (sha != pin, f"sha256 {sha[:12]}… != pin {pin[:12]}…"),
    ) if bad]
    out = subprocess.run([aapt2, "version"], capture_output=True, text=True, timeout=30, stdin=subprocess.DEVNULL)
    if out.returncode != 0:
        problems.append(f"`aapt2 version` kode {out.returncode}: " + diagnose(out.stdout + out.stderr))
    report(not problems, "aapt2 terpasang di rootfs (ELF, executable, sha256 cocok pin)",
           f"{aapt2} {st.st_size} byte sha256 {sha[:12]}… {(out.stdout or out.stderr).strip()[:60]}" if not problems else "; ".join(problems))
except Exception as exc:  # noqa: BLE001
    report(False, "aapt2 terpasang di rootfs (ELF, executable, sha256 cocok pin)", f"{type(exc).__name__}: {exc}")
# Sumber TIDAK bisa diubah runner: persis panggilan yang dilakukan File.setExecutable(true) (chmod) dan tulis harus gagal; hash tidak berubah sesudahnya.
try:
    chmod_denied = write_denied = False
    try:
        os.chmod(aapt2, 0o755)
    except OSError:
        chmod_denied = True
    try:
        open(aapt2, "ab").close()
    except OSError:
        write_denied = True
    with open(aapt2, "rb") as fh:
        unchanged = hashlib.sha256(fh.read()).hexdigest() == pin
    report(chmod_denied and write_denied and unchanged, "sumber aapt2 tidak bisa diubah runner",
           "chmod dan tulis ke sumber ditolak (benar; karena itu apktool memakai salinan di tmpfs khusus), hash tidak berubah" if chmod_denied and write_denied and unchanged
           else f"chmod_ditolak={chmod_denied} tulis_ditolak={write_denied} hash_tetap={unchanged}")
except Exception as exc:  # noqa: BLE001
    report(False, "sumber aapt2 tidak bisa diubah runner", f"{type(exc).__name__}: {exc}")
pin_file = "/opt/apktool/aapt2.sha256"
try:
    with open(shutil.which("apktool") or "/usr/local/bin/apktool") as fh:
        wrapper = fh.read()
    with open(pin_file) as fh:
        pin_in_file = fh.read().strip()
    problems = [msg for bad, msg in (
        ("--aapt" not in wrapper or "aapt-exec" not in wrapper, "wrapper TIDAK menyisipkan --aapt ke salinan di /opt/aapt-exec"),
        ("aapt2.sha256" not in wrapper, "wrapper tidak memverifikasi hash salinan terhadap berkas pin"),
        (pin_in_file != pin, f"berkas pin {pin_file} ({pin_in_file[:12]}…) != ENV AAPT2_SHA256 ({pin[:12]}…)"),
    ) if bad]
    report(not problems, "wrapper apktool menyalin aapt2 terverifikasi dan menyisipkan --aapt untuk b",
           "wrapper memakai salinan di /opt/aapt-exec, hash dipin lewat berkas pin yang sama dengan ENV image" if not problems else "; ".join(problems))
except OSError as exc:
    report(False, "wrapper apktool menyalin aapt2 terverifikasi dan menyisipkan --aapt untuk b", f"{type(exc).__name__}: {exc}")

# 6b. tmpfs exec khusus (/opt/aapt-exec): mount TERPISAH bertipe tmpfs, `exec` + `nosuid,nodev`, ukuran <= 16 MiB, milik uid 10001 (supaya chmod Java lolos).
#     Inilah SATU-SATUNYA tmpfs exec; /tmp harus TETAP noexec (3c, diulang di sini agar kompromi ini terlihat dalam satu cek).
exec_opts, exec_fstype = None, None
with open("/proc/self/mountinfo") as fh:
    for line in fh:
        parts = line.split()
        if len(parts) > 5 and parts[4] == exec_dir and "-" in parts:
            exec_opts = parts[5].split(",")
            exec_fstype = parts[parts.index("-") + 1]
try:
    vfs = os.statvfs(exec_dir)
    exec_size, exec_uid = vfs.f_blocks * vfs.f_frsize, os.stat(exec_dir).st_uid
except OSError as exc:
    exec_size, exec_uid = 0, -1
    print(f"    (tidak bisa membaca {exec_dir}: {type(exc).__name__}: {exc})")
problems = [msg for bad, msg in (
    (exec_opts is None, f"{exec_dir} bukan mount sendiri (tmpfs khusus tidak terpasang: periksa docker-compose.yml / --tmpfs)"),
    (exec_opts is not None and exec_fstype != "tmpfs", f"fstype {exec_fstype}, harus tmpfs"),
    (exec_opts is not None and "noexec" in exec_opts, "mount noexec (aapt2 tidak bisa dijalankan)"),
    (exec_opts is not None and not {"rw", "nosuid", "nodev"} <= set(exec_opts), "opsi harus rw,nosuid,nodev"),
    (not 0 < exec_size <= MAX_EXEC_BYTES, f"ukuran {exec_size} byte di luar (0, {MAX_EXEC_BYTES}]"),
    (exec_uid != RUNNER_UID, f"dimiliki uid {exec_uid}, harus {RUNNER_UID}"),
    (tmp_opts is None or "noexec" not in tmp_opts, "/tmp TIDAK lagi noexec"),
) if bad]
report(not problems, f"tmpfs exec khusus {exec_dir} (terpisah, nosuid,nodev, <=16 MiB, uid {RUNNER_UID}); /tmp tetap noexec",
       f"mount {exec_dir}: {','.join(exec_opts or [])} ({exec_fstype}); ukuran {exec_size // 1024} KiB; uid {exec_uid}; /tmp: {','.join(tmp_opts or [])}" if not problems else "; ".join(problems))

# 6. Kelayakan build: `apktool b` membangun proyek smali minimal OFFLINE (kebutuhan B-1: AI memodifikasi lalu membangun ulang).
#    Dijalankan lewat wrapper `apktool` yang SAMA dengan jalur produksi (wrapper menyalin aapt2 ke /opt/aapt-exec dan menambahkan `--aapt`), di /tmp noexec.
#    Bukti jaringan mati ada di pemeriksaan 4 di atas; di sini yang dibuktikan hanya bahwa build selesai di kontainer yang sama
#    (tanpa jaringan, rootfs read-only, non-root). Proyek diturunkan dari scripts/sample-apk/build.py (APKTOOL_YML, smali_class)
#    dan sengaja tanpa referensi @string/res.
proj = os.path.join(work, "proj")
os.makedirs(os.path.join(proj, "smali", "com", "example", "selftest"))
with open(os.path.join(proj, "apktool.yml"), "w") as fh:
    fh.write(f"version: {version(['apktool', '--version'])}\napkFileName: built.apk\nusesFramework:\n  ids:\n  - 1\n"
             "sdkInfo:\n  minSdkVersion: 24\n  targetSdkVersion: 33\nversionInfo:\n  versionCode: 1\n  versionName: 1.0-selftest\n")
with open(os.path.join(proj, "AndroidManifest.xml"), "w") as fh:
    fh.write('<?xml version="1.0" encoding="utf-8" standalone="no"?>\n'
             '<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.example.selftest">\n'
             '    <application android:allowBackup="false"/>\n</manifest>\n')
with open(os.path.join(proj, "smali", "com", "example", "selftest", "Hello.smali"), "w") as fh:
    fh.write(".class public Lcom/example/selftest/Hello;\n.super Ljava/lang/Object;\n\n"
             ".method public constructor <init>()V\n    .locals 0\n"
             "    invoke-direct {p0}, Ljava/lang/Object;-><init>()V\n    return-void\n.end method\n")
built = os.path.join(work, "built.apk")
try:
    out = subprocess.run(["apktool", "b", proj, "-o", built], capture_output=True, text=True, timeout=180, env=tool_env, stdin=subprocess.DEVNULL)
    text = out.stdout + out.stderr
    bad = [e for e in ENV_ERRORS if e in text]
    report(out.returncode == 0 and not bad, "apktool b dapat membangun proyek smali minimal OFFLINE",
           "build selesai tanpa galat lingkungan" if out.returncode == 0 and not bad else f"kode {out.returncode}: " + diagnose(text))
    ok_zip, names, magic = False, [], b""
    if os.path.exists(built):
        with zipfile.ZipFile(built) as zf:
            ok_zip, names = zf.testzip() is None, zf.namelist()
            magic = zf.read("classes.dex")[:4] if "classes.dex" in names else b""
    report(ok_zip and "AndroidManifest.xml" in names and magic == b"dex\n", "hasil build adalah APK utuh",
           "ZIP valid, AndroidManifest.xml dan classes.dex (magic dex) ada" if ok_zip and magic == b"dex\n" else f"zip_ok={ok_zip} entri={names[:5]} magic={magic!r}")
except Exception as exc:  # noqa: BLE001
    report(False, "apktool b dapat membangun proyek smali minimal OFFLINE", f"{type(exc).__name__}: {exc}")

# 6c. SESUDAH `apktool b`: /opt/aapt-exec hanya berisi `aapt2` (os.listdir juga menampilkan berkas titik, jadi sisa `.aapt2.*` sementara ikut terdeteksi),
#     sha256 salinan cocok pin, milik uid 10001. Berkas lain di tmpfs exec = ada yang menaruh sesuatu di sana.
try:
    names = sorted(os.listdir(exec_dir))
    copy = os.path.join(exec_dir, "aapt2")
    with open(copy, "rb") as fh:
        copy_sha = hashlib.sha256(fh.read()).hexdigest()
    copy_uid = os.stat(copy).st_uid
    ok = names == ["aapt2"] and copy_sha == pin and copy_uid == RUNNER_UID
    report(ok, f"isi {exec_dir} hanya aapt2 (sha256 cocok pin)",
           f"isi: {names}; sha256 {copy_sha[:12]}… == pin; uid {copy_uid}" if ok else f"isi: {names}; sha256 {copy_sha[:12]}… (pin {pin[:12]}…); uid {copy_uid}")
except OSError as exc:
    report(False, f"isi {exec_dir} hanya aapt2 (sha256 cocok pin)", f"{type(exc).__name__}: {exc}")

shutil.rmtree(work, ignore_errors=True)
sys.exit(1 if failed else 0)
