#!/usr/bin/env python3
"""Uji mandiri image bench: BUKTI isolasi dari dalam kontainer sungguhan. Keluar dengan kode != 0 bila ada yang gagal.

Dijalankan lewat `make bench-selftest`, yang memakai opsi isolasi yang sama dengan layanan asli (jaringan internal `benchnet`, --read-only, --cap-drop ALL,
non-root, no-new-privileges). Bila AI_SHELL_NET_ALLOW terisi (BENCH_NET_PROXY terset) ada bagian tambahan yang membuktikan jaringan terkunci ke proxy `egress`. JALANKAN INI di server Anda sebelum menyalakan AI_SHELL_ENABLED=1: yang tidak bisa dibuktikan dari luar kontainer
adalah apakah Landlock benar-benar bekerja di bawah profil seccomp/AppArmor Docker Anda.

Cara kerja: membuat DATA UMPAN di folder sementara (analisis dengan index/ berisi 'rahasia', analisis lain, database) lalu menjalankan perintah
lewat executor yang SAMA dengan produksi. Setiap yang seharusnya ditolak HARUS ditolak, dan tidak ada umpan yang boleh muncul di keluaran.
"""

from __future__ import annotations

import os
import shlex
import socket
import sys
import tempfile
import zipfile
from pathlib import Path

sys.path.insert(0, os.environ.get("PYTHONPATH", "/app").split(":")[0])

from bench import executor, landlock, netprobe, policy, workspace  # noqa: E402

failed = False
UMPAN = "UMPAN-RAHASIA-JANGAN-BOCOR"


def report(ok: bool, name: str, detail: str = "") -> None:
    global failed
    failed = failed or not ok
    print(f"[{'OK ' if ok else 'GAGAL'}] {name}" + (f" — {detail}" if detail else ""))


# --- 1. kontainer
report(os.geteuid() != 0, "bukan root", f"uid={os.geteuid()}")
root_opts = None
with open("/proc/self/mountinfo") as fh:
    for line in fh:
        parts = line.split()
        if len(parts) > 5 and parts[4] == "/":
            root_opts = parts[5].split(",")
            break
report(root_opts is not None and "ro" in root_opts, "rootfs read-only", "mount / opsi: " + (",".join(root_opts) if root_opts else "tidak ditemukan"))
reachable = False
for host in ("1.1.1.1", "8.8.8.8"):
    try:
        with socket.create_connection((host, 443), timeout=3):
            reachable = True
            break
    except OSError:
        pass
report(not reachable, "jaringan terisolasi (selftest sendiri tidak punya rute ke internet)", "koneksi keluar gagal (benar)" if not reachable else "internet TERJANGKAU")
env_leaks = sorted(k for k in os.environ if any(t in k.upper() for t in ("API_KEY", "SECRET", "PASSWORD", "TOKEN", "REDIS")))
report(not env_leaks, "tidak ada rahasia di environment", "bersih" if not env_leaks else "ditemukan: " + ", ".join(env_leaks))

# --- 2. Landlock
abi = landlock.abi_version()
report(abi >= 1, "Landlock tersedia di kontainer ini", f"ABI v{abi}" if abi else "TIDAK tersedia: semua perintah AI akan DITOLAK (benar, gagal tertutup) tetapi fitur tidak berguna")
if abi < 1:
    print("\nLandlock tidak aktif di server ini. AI_SHELL_ENABLED jangan dinyalakan sebelum ini beres (uji `scripts/bench-probe.sh`).")
    sys.exit(1)

# --- 3. data umpan + pengurungan lewat executor produksi
base = Path(tempfile.mkdtemp(prefix="selftest-", dir=os.environ.get("TMPDIR", "/tmp")))
data = base / "data"
SHA, OTHER = "a" * 64, "b" * 64
for d in ("work/1/apktool", "work/1/jadx", "work/1/logs", "work/1/index", "work/2/apktool", "work/2/index", "uploads", "bench/1", "bench/2", "db", "files/1/up"):
    (data / d).mkdir(parents=True, exist_ok=True)
(data / "work/1/apktool/AndroidManifest.xml").write_text("<manifest/>")
(data / "work/1/jadx/A.java").write_text("class A {}")
(data / "work/1/manifest.json").write_text("{}")
(data / "work/1/index/findings.jsonl").write_text(f'{{"secret": "{UMPAN}-INDEX"}}')
(data / "work/2/apktool/x.txt").write_text(f"{UMPAN}-ANALISIS2")
(data / "work/2/index/f.jsonl").write_text(f"{UMPAN}-INDEX2")
(data / "bench/2/catatan.txt").write_text(f"{UMPAN}-BENCH2")
(data / "db/app.sqlite").write_text(f"{UMPAN}-DB")
(data / "files/1/up/l.txt").write_text(f"{UMPAN}-LAMPIRAN")
with zipfile.ZipFile(data / "uploads" / f"{SHA}.apk", "w") as zf:
    zf.writestr("AndroidManifest.xml", "x")
(data / "uploads" / f"{OTHER}.apk").write_text(f"{UMPAN}-APKLAIN")

dirs = policy.Dirs(data)
limits = executor.Limits(max_timeout=20, output_bytes=8192, nproc=int(os.environ.get("BENCH_NPROC", "2048")))
executor.enable_subreaper()
D = str(data)


def run(cmd: str, timeout: int = 15, net: "executor.NetConfig | None" = None) -> dict:
    return executor.run_confined(dirs, limits, analysis_id=1, command=cmd, timeout=timeout, sha256=SHA, job_id="s1-selftest0001", net=net)


def must_work(name: str, cmd: str, expect: str = "") -> None:
    r = run(cmd)
    ok = r["status"] == "ok" and r["exit_code"] == 0 and (expect in r["stdout"])
    report(ok, name, "" if ok else f"status={r['status']} exit={r['exit_code']} {r.get('message', '')} {r['stderr'][:100]!r}")


def must_block(name: str, cmd: str) -> None:
    r = run(cmd)
    leaked = UMPAN in r["stdout"] + r["stderr"]
    blocked = r["status"] == "ok" and r["exit_code"] != 0
    report(blocked and not leaked, name, "ditolak" if blocked and not leaked else ("BOCOR: umpan terbaca" if leaked else f"TIDAK ditolak (status={r['status']} exit={r['exit_code']})"))


r0 = run("true")
if r0["status"] == "refused":
    report(False, "pengurungan dapat dipasang", r0.get("message", ""))
    sys.exit(1)
report(True, "pengurungan dapat dipasang")

must_work("membaca manifest analisis sendiri", "cat $WORK/apktool/AndroidManifest.xml", "<manifest/>")
must_work("membaca kode jadx analisis sendiri", "cat $WORK/jadx/A.java", "class A")
must_work("membuka APK sendiri", "unzip -l $APK", "AndroidManifest.xml")
must_work("menulis dan membaca di ruang kerja", "echo halo > $WS/a.txt && cat $WS/a.txt", "halo")
must_work("python3 tersedia", "python3 -c 'print(6*7)'", "42")
must_block("index/ analisis sendiri (rahasia mentah): baca", "cat $WORK/index/findings.jsonl")
must_block("index/ analisis sendiri: daftar", "ls $WORK/index")
must_block("analisis lain: baca", f"cat {D}/work/2/apktool/x.txt")
must_block("index analisis lain: baca", f"cat {D}/work/2/index/f.jsonl")
must_block("ruang kerja bench lain: baca", f"cat {D}/bench/2/catatan.txt")
must_block("ruang kerja bench: daftar semua", f"ls {D}/bench")
must_block("database: baca", f"cat {D}/db/app.sqlite")
must_block("lampiran: baca", f"cat {D}/files/1/up/l.txt")
must_block("APK lain: baca", f"cat {D}/uploads/{OTHER}.apk")
must_block("folder uploads: daftar", f"ls {D}/uploads")
must_block("/data: daftar", f"ls {D}")
must_block("hasil dekompilasi: tulis", "echo x > $WORK/apktool/hack.txt")
must_block("hasil dekompilasi: hapus", "rm $WORK/apktool/AndroidManifest.xml")
must_block("hasil dekompilasi: ganti nama", "mv $WORK/apktool/AndroidManifest.xml $WS/x")
must_block("tautan keras keluar ruang kerja", "ln $WORK/jadx/A.java $WS/tautan")
must_block("symlink ke index/ lalu baca", "ln -s $WORK/index $WS/s && cat $WS/s/findings.jsonl")
must_block("lewat /proc/self/root", "cat /proc/self/root$WORK/index/findings.jsonl")
must_block("lewat ..", "cat $WS/../2/catatan.txt")
must_block("lingkungan daemon (/proc/<ppid>/environ)", "cat /proc/$PPID/environ")
# --- 3a. $WS/project: op init/diff (Tahap 2b) dan pohon yang dibangun. Op ini dikerjakan daemon (tak terkurung); perintah AI mengubah `project/` di dalam kurungan.
init1 = workspace.op_init(dirs, limits.workspace_bytes, 1, False, timeout=60)
report(init1["status"] == "ok" and init1.get("created") is True and (data / "bench/1/project/AndroidManifest.xml").is_file(), "init menyalin baseline ke $WS/project",
       f"status={init1['status']} created={init1.get('created')} {init1.get('message', '')}")
(data / "bench/1/project/PEKERJAAN-AI.txt").write_text("jangan ditimpa")
init2 = workspace.op_init(dirs, limits.workspace_bytes, 1, False, timeout=60)
report(init2["status"] == "ok" and init2.get("created") is False and (data / "bench/1/project/PEKERJAAN-AI.txt").is_file(), "init kedua TIDAK menimpa pekerjaan di project/",
       f"created={init2.get('created')} reason={init2.get('reason')}")
(data / "bench/1/project/PEKERJAAN-AI.txt").unlink()
d0 = workspace.op_diff(dirs, 1, timeout=60)
c0 = d0.get("counts") or {}
report(d0["status"] == "ok" and not any(c0.values()), "diff pohon yang baru di-init kosong", f"status={d0['status']} counts={c0}")
must_work("perintah terkurung boleh MENULIS di $WS/project (berkas baru + ubah berkas ada dengan sed -i)",
          "mkdir -p $WS/project/res/values && echo '<resources/>' > $WS/project/res/values/strings.xml && sed -i 's/manifest/MANIFEST/' $WS/project/AndroidManifest.xml "
          "&& cat $WS/project/AndroidManifest.xml", "<MANIFEST/>")
must_block("perintah terkurung TIDAK boleh menulis baseline lewat $WORK (pohon yang dibangun hanya $WS/project)", "echo x > $WORK/apktool/dari-ai.txt")
d1 = workspace.op_diff(dirs, 1, timeout=60)
c1 = d1.get("counts") or {}
report(d1["status"] == "ok" and c1 == {"added": 1, "modified": 1, "removed": 0} and d1["diff_sha256"] != d0["diff_sha256"], "diff melihat tepat 1 berkas ditambah dan 1 diubah",
       f"status={d1['status']} counts={c1}")
report((data / "work/1/apktool/AndroidManifest.xml").read_text() == "<manifest/>" and not (data / "work/1/apktool/dari-ai.txt").exists(), "baseline work/<id>/apktool tidak berubah")
report(not os.path.lexists("/data/builds"), "volume bench TIDAK memuat builds", "/data/builds tidak ada" if not os.path.lexists("/data/builds") else "/data/builds ADA di bench")

# Jaringan dari DALAM perintah AI TANPA konfigurasi jaringan (keadaan bawaan). Dua lapis: (1) jaringan internal tanpa rute keluar (cek di atas), (2) Landlock TCP
# (ABI >= 4). Cek ini hanya bermakna bila lapis 1 terbukti; bila tidak, hasilnya TIDAK membuktikan apa pun tentang Landlock dan ditandai jelas.
net = run("python3 -c \"import socket; socket.create_connection(('1.1.1.1', 443), timeout=3)\"")
net_blocked = net["status"] == "ok" and net["exit_code"] != 0
if abi >= 4:
    report(net_blocked, "jaringan dari perintah AI ditolak (lapis Landlock TCP, ABI >= 4)", "ditolak" if net_blocked else "TIDAK ditolak")
else:
    report(not reachable and net_blocked, f"jaringan dari perintah AI ditolak (hanya lapis kontainer; Landlock ABI v{abi} belum mengunci TCP)",
           "ditolak oleh jaringan internal" if (not reachable and net_blocked) else ("kontainer TIDAK terisolasi: lapis satu-satunya tidak ada" if reachable else "TIDAK ditolak"))

# --- 3b. jaringan lewat proxy egress (hanya bila diminta: AI_SHELL_NET_ALLOW terisi -> compose mengisi BENCH_NET_PROXY)
PROBE = Path(executor.__file__).with_name("netprobe.py")
(data / "bench/1/netprobe.py").write_text(PROBE.read_text(encoding="utf-8"), encoding="utf-8")


def probe(args: str, net: "executor.NetConfig | None" = None) -> str:
    r = run(f"python3 $WS/netprobe.py {args}", timeout=20, net=net)
    return (r["stdout"].strip().splitlines() or [f"(tanpa keluaran: status={r['status']} exit={r['exit_code']} {r['stderr'][:80]!r})"])[-1]


# DNS: nama publik TIDAK boleh bisa di-resolve dari perintah AI (kalau bisa, DNS menjadi jalan keluar data yang melewati daftar putih host).
dns_pub = probe("resolve example.com")
report(dns_pub == "NXDOMAIN", "DNS publik tidak bisa di-resolve dari perintah AI (tidak ada jalan keluar lewat DNS)", dns_pub if dns_pub != "NXDOMAIN" else "tidak bisa (benar)")

proxy_raw = os.environ.get("BENCH_NET_PROXY", "").strip()
if not proxy_raw:
    print("[ -- ] jaringan shell AI mati (AI_SHELL_NET_ALLOW kosong): bagian proxy dilewati. Isi AI_SHELL_NET_ALLOW di .env lalu `docker compose up -d` dan jalankan lagi.")
elif abi < 4:
    print(f"[ -- ] BENCH_NET_PROXY={proxy_raw} tetapi Landlock ABI v{abi} < 4: daemon akan MENGANTIKAN jaringan dengan MATI (tidak ada pengunci TCP). Bagian proxy dilewati.")
else:
    phost, _, pport = proxy_raw.rpartition(":")
    NET = executor.NetConfig(phost, int(pport))
    got = probe("direct 1.1.1.1 443", NET)
    report(got == "ERRNO EACCES", "dengan jaringan menyala: TCP langsung ke internet ditolak Landlock (EACCES)", got)
    got = probe(f"direct {phost} 80", NET)
    report(got == "ERRNO EACCES", "dengan jaringan menyala: port lain pada host proxy ditolak Landlock (EACCES)", got)
    reach = probe(f"direct {phost} {pport}", NET)
    report(reach == "CONNECTED", f"proxy {phost}:{pport} terjangkau dari perintah AI", "ya" if reach == "CONNECTED" else reach)
    report(probe(f"resolve {phost}", NET).startswith("RESOLVED"), f"nama kontainer `{phost}` bisa di-resolve (DNS Docker bekerja pada jaringan internal)")
    if reach == "CONNECTED":
        for target in (t.replace("{proxy}", f"{phost}:{pport}") for t in netprobe.DENY_TARGETS):
            got = probe(f"connect {phost} {pport} {target}", NET)
            report(got.startswith("STATUS 4") and got.split()[1] == "403", f"proxy menolak {target}", got)
    else:
        print("[ -- ] penolakan proxy tidak diuji karena proxy tidak terjangkau (jalankan `docker compose up -d egress`)")
    url = os.environ.get("SELFTEST_NET_URL", "").strip()
    if url:
        r = run(f"curl -sS -m 20 -o /dev/null -w '%{{http_code}}' {shlex.quote(url)}", timeout=30, net=NET)
        code = r["stdout"].strip()
        report(r["exit_code"] == 0 and code.isdigit() and code != "000", f"jalur penuh ke {url} lewat proxy", f"HTTP {code}" if r["exit_code"] == 0 else f"exit={r['exit_code']} {r['stderr'][:150]!r}")
    else:
        print("[ -- ] jalur penuh ke internet tidak diuji (butuh URL nyata): `make net-check URL=https://api.contoh.com/health`")

# --- 4. batas dan pembersihan
r = run("sleep 30", timeout=2)
report(r["status"] == "timeout" and r["duration_ms"] < 10000, "batas waktu menghentikan perintah", f"status={r['status']} {r['duration_ms']}ms")
r = run("(sleep 60 &); (setsid sleep 60 &); echo mulai")
import time  # noqa: E402
time.sleep(0.5)
left = executor._children_of(os.getpid())
report(r["status"] == "ok" and not left, "tidak ada proses sisa (anak yatim + setsid dimatikan)", "bersih" if not left else f"sisa: {left}")
r = run("head -c 3000000 /dev/zero | tr '\\0' A; echo AKHIR")
report(r["truncated"] and len(r["stdout"]) < 20000 and r["stdout"].endswith("AKHIR\n"), "keluaran besar dipotong (kepala+ekor)", f"{len(r['stdout'])} karakter diterima")

sys.exit(1 if failed else 0)
