#!/usr/bin/env python3
"""Entrypoint TETAP tool AI `analyze_native_library`: bedah SATU library .so dengan Ghidra headless, di dalam kurungan bench.

Dipanggil web lewat spool bench sebagai perintah dengan argv tetap (bukan string shell bebas dari AI):

    /usr/local/bin/bench-ghidra <path-relatif-.so-di-$WS>
    /usr/local/bin/bench-ghidra fungsi <path-relatif-.so-di-$WS> <nama-fungsi>

Mode `fungsi` (tool AI `read_native_function`) TIDAK menjalankan Ghidra: ia memotong
dekompilasi SATU fungsi dari artefak .c yang sudah dihasilkan mode analisis, agar AI
melihat kode ASLI fungsi yang ia simpulkan — bukan hanya ringkasan.

Satu-satunya bagian variabel adalah path library, yang divalidasi web DAN divalidasi ulang di sini:
harus relatif terhadap $WS, tetap di dalam $WS setelah resolusi symlink, berkas biasa, dan ELF
little-endian (aarch64/arm/x86). .so TIDAK PERNAH dieksekusi: Ghidra hanya menganalisisnya statis.

Keluaran: SATU baris JSON ringkas di stdout (kontrak untuk web): {"ok": true, ...ringkasan...} atau
{"ok": false, "error": "..."}. Artefak penuh ditulis ke $WS/hasil_ai/ghidra/<stem>.json dan
<stem>.c agar bisa dibaca AI berkeping-keping lewat shell_run. Kode keluar selalu 0 bila kontrak
JSON tercetak; kegagalan analisis adalah DATA di JSON, bukan kode keluar.

Jebakan JDK (pelajaran runner PR #57): JVM mengambil user.home dari /etc/passwd, BUKAN $HOME, dan
LaunchSupport Ghidra menolak jalan bila direktori itu tidak bisa ditulis (ia menyimpan
java_home.save di <user.home>/.config/ghidra/). Di dalam kurungan Landlock, home passwd
(/tmp/home) tidak terjangkau; yang bisa ditulis hanya $WS dan scratch per-job (= $HOME terkurung).
Karena itu skrip ini menyetel -Duser.home=$HOME lewat JAVA_TOOL_OPTIONS untuk JVM Ghidra:
properti sistem itu menimpa nilai bawaan dari passwd. Hal yang sama berlaku untuk
java.io.tmpdir (bawaan /tmp, tertutup Landlock): diarahkan ke $HOME juga — tanpa itu Ghidra
bisa gagal di tengah analisis besar saat butuh berkas sementara (umpan balik AI di produksi).
"""

from __future__ import annotations

import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

GHIDRA_HOME = Path(os.environ.get("GHIDRA_HOME", "/opt/ghidra"))
SCRIPT_DIR = Path("/usr/local/lib/bench-ghidra")
OUT_SUBDIR = Path("hasil_ai") / "ghidra"
MAX_LIB_BYTES = 64 * 1024 * 1024          # sama dengan pagar analyzer runner
MAX_DECOMPILE = 200                       # fungsi didekompilasi per library (prioritas di GhidraExport.java)
ANALYSIS_TIMEOUT_PER_FILE = 240           # detik; pagat luar ditegakkan bench (BENCH_GHIDRA_MAX_TIMEOUT)
NAME_RE = re.compile(r"^[A-Za-z0-9._\-/]+$")
_URL_RE = re.compile(r"https?://[^\s\"'<>]{4,200}")
_FLAGGED_IMPORTS = ("ptrace", "dlopen", "system", "popen", "mprotect")
# e_machine ELF -> (nama arsitektur, bahasa prosesor Ghidra). Hanya little-endian (semua .so Android LE).
ELF_MACHINES = {183: ("aarch64", "AARCH64:LE:64:v8A"), 40: ("arm", "ARM:LE:32:v7"),
                62: ("x86-64", "x86:LE:64:default"), 3: ("x86", "x86:LE:32:default")}


JVM_CANDIDATES = ("/usr/lib/jvm/java-21-openjdk-amd64", "/usr/lib/jvm/java-21-openjdk-arm64",
                  "/usr/lib/jvm/default-java")


def _ghidra_env(base, fallback_home: str) -> dict:
    """Env untuk JVM Ghidra di dalam kurungan Landlock.

    user.home DAN java.io.tmpdir diarahkan ke $HOME terkurung (scratch per-job, bisa
    ditulis); bawaan keduanya (passwd / /tmp) tertutup Landlock. JAVA_HOME diisi dari
    kandidat standar HANYA bila belum ter-set dan berkas javanya benar ada — penemuan
    JDK bawaan LaunchSupport tidak pernah ditimpa tebakan.
    """
    env = dict(base)
    home = env.get("HOME") or fallback_home
    opts = f"-Duser.home={home} -Djava.io.tmpdir={home}"
    env["JAVA_TOOL_OPTIONS"] = (env.get("JAVA_TOOL_OPTIONS", "") + " " + opts).strip()
    if not env.get("JAVA_HOME"):
        for cand in JVM_CANDIDATES:
            if Path(cand, "bin", "java").is_file():
                env["JAVA_HOME"] = cand
                break
    return env


def detect_language(header: bytes) -> tuple[str, str]:
    """(arsitektur, bahasa Ghidra) dari 20 byte pertama berkas. ValueError bila bukan ELF LE yang dikenal."""
    if len(header) < 20 or header[:4] != b"\x7fELF":
        raise ValueError("bukan berkas ELF")
    if header[5] != 1:
        raise ValueError("ELF big-endian tidak didukung (library Android selalu little-endian)")
    machine = int.from_bytes(header[18:20], "little")
    if machine not in ELF_MACHINES:
        raise ValueError(f"arsitektur ELF tidak dikenal (e_machine={machine})")
    return ELF_MACHINES[machine]


def resolve_library(arg: str, ws: Path) -> Path:
    """Path library yang sah di dalam `ws`. ValueError dengan pesan aman untuk model."""
    if not NAME_RE.match(arg) or not arg.endswith(".so") or arg.startswith("/"):
        raise ValueError("nama library harus path relatif berakhiran .so (huruf/angka/._-/)")
    parts = arg.split("/")
    if any(p in ("", ".", "..") for p in parts):
        raise ValueError("path library tidak boleh memuat segmen kosong, '.', atau '..'")
    base = ws.resolve()
    target = (base / arg).resolve()                      # symlink ditempuh SEKALI di sini, lalu dinilai
    if target != base and base not in target.parents:
        raise ValueError("path library keluar dari ruang kerja")
    if not target.is_file():
        raise ValueError(f"library tidak ditemukan di ruang kerja: {arg}")
    if target.stat().st_size > MAX_LIB_BYTES:
        raise ValueError(f"library terlalu besar (> {MAX_LIB_BYTES // (1024 * 1024)} MB)")
    return target


def build_summary(data: dict, lib_name: str, stem: str, decompiled: int, duration_s: float) -> dict:
    """Ringkasan ringkas dari JSON ekspor Ghidra (bentuk analyzer/GhidraExport.java)."""
    funcs = data.get("functions") or []
    imports = data.get("imports") or []
    strings = data.get("strings") or []
    urls = sorted({u.rstrip(").,;") for s in strings for u in _URL_RE.findall(s.get("value", ""))})
    return {
        "ok": True,
        "library": lib_name,
        "language": data.get("language"),
        "image_base": data.get("image_base"),
        "functions_total": len(funcs),
        "functions_truncated": bool(data.get("functions_truncated")),
        "jni_functions": [f.get("name") for f in funcs if f.get("jni")][:40],
        "vector_fp_functions": [f.get("name") for f in funcs if f.get("vector_fp")][:40],
        "imports_total": len(imports),
        "imports_flagged": [n for n in _FLAGGED_IMPORTS if n in imports],
        "strings_total": len(strings),
        "urls": urls[:5],
        "crypto_constants": [str(c).split("@")[0] for c in (data.get("crypto_constants") or [])],
        "decompiled": decompiled,
        "artifacts": {"json": f"{OUT_SUBDIR.as_posix()}/{stem}.json", "c": f"{OUT_SUBDIR.as_posix()}/{stem}.c"},
        "duration_s": round(duration_s, 1),
    }


def _emit(obj: dict) -> int:
    print(json.dumps(obj, ensure_ascii=False), flush=True)
    return 0


# ---------------------------------------------------------------- mode fungsi (baca dekompilasi per fungsi)
_HEADER_RE = re.compile(r"^/\* ==== (\S+) (.+?) ==== \*/$", re.M)
MAX_CODE_CHARS = 11000        # kode satu fungsi yang dikembalikan utuh (pagat hasil tool web 14.000 char)


def _split_functions(text: str) -> list[tuple[str, str, int, str]]:
    """[(nama, alamat, baris_penanda_1based, badan)] dari artefak .c GhidraExport (penanda /* ==== */)."""
    marks = list(_HEADER_RE.finditer(text))
    out = []
    for i, m in enumerate(marks):
        name = m.group(2)
        for flag in (" [jni]", " [vektor-fp]"):
            if name.endswith(flag):
                name = name[: -len(flag)]
        end = marks[i + 1].start() if i + 1 < len(marks) else len(text)
        first_line = text.count("\n", 0, m.start()) + 1
        out.append((name.strip(), m.group(1), first_line, text[m.end():end].strip("\n")))
    return out


def read_function(arg: str, func_name: str) -> int:
    """Keluarkan dekompilasi fungsi `func_name` dari artefak .c milik library `arg` sebagai JSON kontrak."""
    ws = Path(os.environ.get("WS") or os.getcwd())
    try:
        target = resolve_library(arg, ws)
    except ValueError as exc:
        return _emit({"ok": False, "error": str(exc)})
    if not func_name or len(func_name) > 200 or any(ord(c) < 32 for c in func_name):
        return _emit({"ok": False, "error": "nama fungsi tidak sah"})
    stem = re.sub(r"[^A-Za-z0-9_.-]+", "_", target.name[:-3])     # buang ".so" (sama dengan mode analisis)
    c_path = ws / OUT_SUBDIR / f"{stem}.c"
    if not c_path.is_file():
        return _emit({"ok": False, "error": f"artefak dekompilasi {stem}.c belum ada; jalankan analyze_native_library pada {target.name} dulu"})
    try:
        text = c_path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return _emit({"ok": False, "error": "artefak dekompilasi tidak bisa dibaca"})
    blocks = _split_functions(text)
    chosen = next((b for b in blocks if b[0] == func_name), None)
    if chosen is None:
        subs = [b for b in blocks if func_name in b[0]]
        if len(subs) == 1:
            chosen = subs[0]
        elif len(subs) > 1:
            return _emit({"ok": False, "error": f"nama fungsi ambigu ({len(subs)} kandidat): "
                                                 + ", ".join(b[0] for b in subs[:10])})
    if chosen is None:
        return _emit({"ok": False, "error": f"fungsi '{func_name}' tidak ada di dekompilasi (atau tidak termasuk "
                                             f"{MAX_DECOMPILE} fungsi yang didekompilasi). Contoh yang ada: "
                                             + ", ".join(b[0] for b in blocks[:10])})
    name, addr, first_line, body = chosen
    total_lines = body.count("\n") + 1
    truncated = len(body) > MAX_CODE_CHARS
    shown, shown_lines = body, total_lines
    if truncated:
        cut = body.rfind("\n", 0, MAX_CODE_CHARS)
        shown = body[: cut if cut > 0 else MAX_CODE_CHARS]
        shown_lines = shown.count("\n") + 1
    return _emit({"ok": True, "library": target.name, "function": name, "address": addr,
                  "code": shown, "truncated": truncated,
                  "line_start": first_line + 1, "line_end": first_line + shown_lines,
                  "total_lines": total_lines, "artifact": f"{OUT_SUBDIR.as_posix()}/{stem}.c"})


def run(arg: str) -> int:
    ws = Path(os.environ.get("WS") or os.getcwd())
    try:
        target = resolve_library(arg, ws)
        with open(target, "rb") as fh:
            _arch, language = detect_language(fh.read(20))
    except (ValueError, OSError) as exc:
        return _emit({"ok": False, "error": str(exc) if isinstance(exc, ValueError) else "library tidak bisa dibaca"})

    headless = GHIDRA_HOME / "support" / "analyzeHeadless"
    if not headless.is_file():
        return _emit({"ok": False, "error": "Ghidra tidak terpasang di bench"})

    stem = re.sub(r"[^A-Za-z0-9_.-]+", "_", target.name[:-3])     # buang ".so"
    out_dir = ws / OUT_SUBDIR
    proj_dir = out_dir / f".proj-{stem}"
    json_out, c_out = out_dir / f"{stem}.json", out_dir / f"{stem}.c"
    try:
        out_dir.mkdir(parents=True, exist_ok=True)
        proj_dir.mkdir(parents=True, exist_ok=True)              # analyzeHeadless menuntut dir proyek SUDAH ada
    except OSError:
        return _emit({"ok": False, "error": "folder hasil tidak bisa dibuat di ruang kerja"})

    # Atasi jebakan user.home + tmpdir (lihat docstring): arahkan ke $HOME terkurung (scratch per-job).
    env = _ghidra_env(os.environ, str(proj_dir))
    try:                                                          # paritas pelajaran runner: buat home passwd bila bisa
        Path(pwd.getpwuid(os.getuid()).pw_dir).mkdir(parents=True, exist_ok=True)
    except (OSError, KeyError):
        pass

    cmd = [str(headless), str(proj_dir), "AiNative", "-import", str(target),
           "-processor", language, "-scriptPath", str(SCRIPT_DIR),
           "-postScript", "GhidraExport.java", str(json_out), str(c_out), str(MAX_DECOMPILE),
           "-deleteProject", "-analysisTimeoutPerFile", str(ANALYSIS_TIMEOUT_PER_FILE)]
    t0 = time.monotonic()
    try:
        proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env)
        output = proc.stdout or ""
    except OSError as exc:
        return _emit({"ok": False, "error": f"analyzeHeadless tidak bisa dimulai ({type(exc).__name__})"})
    finally:
        shutil.rmtree(proj_dir, ignore_errors=True)
    duration = time.monotonic() - t0

    data = None
    if json_out.is_file():
        try:
            data = json.loads(json_out.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            data = None
    if data is None:
        tail = " | ".join(ln.strip() for ln in output.splitlines() if ln.strip())[-300:]
        return _emit({"ok": False, "error": "Ghidra gagal menganalisis library ini", "tail": tail})
    decompiled = 0
    if c_out.is_file():
        try:
            decompiled = c_out.read_text(encoding="utf-8", errors="replace").count("\n/* ==== ")
        except OSError:
            decompiled = 0
    return _emit(build_summary(data, target.name, stem, decompiled, duration))


def main(argv: list[str]) -> int:
    if len(argv) >= 2 and argv[1] == "fungsi":
        if len(argv) != 4:
            return _emit({"ok": False, "error": "pemakaian: bench-ghidra fungsi <path-relatif-.so> <nama-fungsi>"})
        try:
            return read_function(argv[2], argv[3])
        except Exception as exc:  # noqa: BLE001 - kontrak JSON tidak boleh rusak oleh galat tak terduga
            return _emit({"ok": False, "error": f"galat internal bench-ghidra ({type(exc).__name__})"})
    if len(argv) != 2:
        return _emit({"ok": False, "error": "pemakaian: bench-ghidra <path-relatif-.so>"})
    try:
        return run(argv[1])
    except Exception as exc:  # noqa: BLE001 - kontrak JSON tidak boleh rusak oleh galat tak terduga
        return _emit({"ok": False, "error": f"galat internal bench-ghidra ({type(exc).__name__})"})


if __name__ == "__main__":
    sys.exit(main(sys.argv))
