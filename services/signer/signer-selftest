                    "bila belum, 'make keystore' lalu 'make up'")


def emit(line: str) -> None:
    print(line)
    printed.append(line)


def report(ok: bool, name: str, detail: str = "") -> None:
    global failed
    failed = failed or not ok
    counts["ok" if ok else "gagal"] += 1
    emit(f"[{'OK ' if ok else 'GAGAL'}] {name}" + (f" — {detail}" if detail else ""))


def skip(reason: str) -> None:
    """Pemeriksaan tidak berlaku di sini (bukan gagal): dihitung sebagai DILEWATI di ringkasan dan tidak mengubah kode keluar."""
    counts["skip"] += 1
    emit(f"[ -- ] DILEWATI — {reason}")


def info(name: str, detail: str = "") -> None:
    emit(f"[ -- ] {name}" + (f" — {detail}" if detail else ""))


def run(cmd: list[str], env: dict | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=120, stdin=subprocess.DEVNULL, env=env)


def first_line(out: subprocess.CompletedProcess) -> str:
    text = (out.stdout or out.stderr).strip().splitlines()
    return text[0] if text else f"(kode {out.returncode})"


def tail(out: subprocess.CompletedProcess, n: int = 3) -> str:
    text = (out.stdout + out.stderr).strip().splitlines()
    return " | ".join(text[-n:]) if text else f"(kode {out.returncode})"


# ---------------------------------------------------------------- helper murni (diuji tanpa Docker/Java)
def make_test_apk(path: str, *, misaligned: bool = False) -> None:
    """ZIP minimal bergaya APK, dari stdlib. `misaligned=True` menyisipkan entri STORED berukuran ganjil di depan
    agar offset data entri STORED berikutnya BUKAN kelipatan 4 (zipalign -c gagal, zipalign -f mengubahnya)."""
    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as zf:
        zf.writestr("AndroidManifest.xml", b"\x00junk-manifest" * 8)
        if misaligned:
            zf.writestr(zipfile.ZipInfo("assets/ganjil.bin"), b"x" * 13, compress_type=zipfile.ZIP_STORED)
        # classes.dex disimpan apa adanya (STORED) agar marker perusakan terbaca utuh di dalam berkas.
        zf.writestr(zipfile.ZipInfo("classes.dex"), b"dex\n035\x00" + DEX_MARKER + bytes(range(64)) * 4, compress_type=zipfile.ZIP_STORED)
        zf.writestr(zipfile.ZipInfo("resources.arsc"), b"arsc-data-" * 32, compress_type=zipfile.ZIP_STORED)
        zf.writestr(zipfile.ZipInfo("lib/arm64-v8a/libuji.so"), b"\x7fELF" + b"\x00" * 60, compress_type=zipfile.ZIP_STORED)


def tamper(src: str, dst: str, marker: bytes = DEX_MARKER) -> None:
    """Salin `src` ke `dst` lalu balik SATU byte di dalam payload (marker unik), bukan di header ZIP.
    Struktur ZIP tetap terbaca tetapi isinya berubah (digest tak lagi cocok dengan tanda tangan)."""
    with open(src, "rb") as fh:
        data = bytearray(fh.read())
    at = data.find(marker)
    if at < 0:
        raise ValueError("marker tidak ditemukan; APK uji tidak berisi payload yang bisa dirusak")
    data[at] ^= 0xFF
    with open(dst, "wb") as fh:
        fh.write(data)


def stored_data_offsets(path: str) -> dict[str, int]:
    """Offset awal data tiap entri STORED (dihitung dari header lokal), untuk memeriksa keselarasan."""
    out: dict[str, int] = {}
    with zipfile.ZipFile(path) as zf, open(path, "rb") as fh:
        for zi in zf.infolist():
            if zi.compress_type != zipfile.ZIP_STORED:
                continue
            fh.seek(zi.header_offset)
            hdr = fh.read(30)
            n, m = struct.unpack("<HH", hdr[26:30])
            out[zi.filename] = zi.header_offset + 30 + n + m
    return out


def find_keystores(root: str, skip: tuple[str, ...] = PRUNE) -> list[str]:
    """Cari berkas keystore/kunci privat di bawah `root` (berdasarkan ekstensi/nama). `cacerts` (trust store publik Java) tak berekstensi, jadi tidak ikut."""
    found: list[str] = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if os.path.join(dirpath, d) not in skip]
        for name in filenames:
            if name.lower().endswith(KEY_EXT) or name in KEY_NAMES:
                found.append(os.path.join(dirpath, name))
    return found


# ---------------------------------------------------------------- bagian-bagian
def check_tools() -> None:
    for label, cmd in (
        ("java", ["java", "-version"]),
        ("keytool", ["keytool", "-version"]),
        ("apksigner", ["apksigner", "--version"]),
        ("zipalign", ["zipalign"]),
    ):
        try:
            out = run(cmd)
            if label == "zipalign":
                # zipalign tak punya --version; tanpa argumen ia mencetak usage dan keluar dengan kode != 0.
                ok = "Zip alignment utility" in (out.stdout + out.stderr)
                report(ok, label, first_line(out) + f" (paket Build-Tools {os.environ.get('BUILD_TOOLS_VERSION', '?')})")
            elif label == "apksigner":
                report(out.returncode == 0, label, f"{first_line(out)} (paket Build-Tools {os.environ.get('BUILD_TOOLS_VERSION', '?')})")
            else:
                report(out.returncode == 0, label, first_line(out))
        except Exception as exc:  # noqa: BLE001
            report(False, label, f"{type(exc).__name__}: {exc}")
    try:
        wrapper = open(shutil.which("apksigner") or "/usr/local/bin/apksigner").read()
        missing = [f for f in WRAPPER_FLAGS if f not in wrapper]
        report(not missing, "wrapper apksigner", "flag lengkap" if not missing else "tidak memuat: " + ", ".join(missing))
    except OSError as exc:
        report(False, "wrapper apksigner", str(exc))


def check_secrets_dir(path: str = SECRETS_DIR) -> tuple[bool, str]:
    """`/run/secrets` hanya berisi TEPAT {signing_keystore, signing_keystore_pass} bila keystore dipasang, atau tidak ada/kosong bila tidak.
    Hanya NAMA yang dilaporkan; isi berkas tidak dibaca."""
    if not os.path.lexists(path):
        return True, "tidak ada (keystore tidak dipasang)"
    if not os.path.isdir(path):
        return False, f"{path} bukan direktori"
    names = sorted(os.listdir(path))
    if not names:
        return True, "kosong (keystore tidak dipasang)"
    if names != sorted(SECRETS_NAMES):
        return False, "isi tidak sesuai: " + ", ".join(names)
    bad = [n for n in names if os.path.islink(os.path.join(path, n)) or not os.path.isfile(os.path.join(path, n))]
    if bad:
        return False, "bukan berkas biasa: " + ", ".join(bad)
    return True, "tepat dua berkas keystore (" + ", ".join(names) + ")"


def check_data_dir(path: str = DATA_DIR) -> tuple[bool, str]:
    """`/data` hanya berisi `builds`, `signspool`, dan `signwork`; akar ketiganya dapat ditulis uid ini (tulis-hapus berkas `.selftest-<acak>`)."""
    if not os.path.isdir(path):
        return False, f"{path} tidak ada (volume builds/signspool/signwork tidak terpasang?)"
    names = sorted(os.listdir(path))
    if names != sorted(DATA_NAMES):
        return False, "isi " + path + " tidak sesuai: " + (", ".join(names) or "(kosong)") + "; seharusnya " + ", ".join(sorted(DATA_NAMES))
    for name in DATA_NAMES:
        probe = os.path.join(path, name, f".selftest-{secrets.token_hex(6)}")
        try:
            with open(probe, "w"):
                pass
            os.remove(probe)
        except OSError as exc:
            return False, f"{os.path.join(path, name)} tidak dapat ditulis oleh uid {os.geteuid()}: {exc.strerror or exc}"
    return True, "builds, signspool, dan signwork; akar ketiganya dapat ditulis uid " + str(os.geteuid())


def _key_home() -> str:
    home = os.path.join(os.environ.get("HOME", "/tmp/home"), "_key")
    try:
        os.makedirs(home, mode=0o700, exist_ok=True)
    except OSError:
        pass
    return home


def _keytool_run(argv: list[str], *, deadline: float, home: str, stderr: str = "separate") -> ToolResult:
    """Adaptor `run` untuk signkeys.owner_fingerprint (kontrak: deadline = time.monotonic() absolut). Kata sandi hanya lewat -storepass:file."""
    try:
        proc = subprocess.run(argv, capture_output=True, timeout=max(1.0, deadline - time.monotonic()), stdin=subprocess.DEVNULL,
                              env={**os.environ, "HOME": str(home)})
    except subprocess.TimeoutExpired:
        return ToolResult(None, b"", "tenggat")
    except OSError as exc:
        return ToolResult(None, b"", type(exc).__name__)
    return ToolResult(proc.returncode, proc.stdout, proc.stderr.decode("utf-8", errors="replace")[-300:])


def check_keystore(secrets_dir: str = SECRETS_DIR) -> None:
    """Kunci pemilik di `secrets_dir` (bawaan /run/secrets). Tidak ada keystore -> DILEWATI (instalasi tanpa keystore tetap sah), BUKAN gagal."""
    p12, passfile = os.path.join(secrets_dir, KS_NAME), os.path.join(secrets_dir, PASS_NAME)
    first = inspect_key_file(p12, kind="p12")
    if first.state == "missing":
        skip(SKIP_NO_KEYSTORE)
        return
    euid = os.geteuid()
    both_ok = True
    for label, state in ((KS_NAME, first), (PASS_NAME, inspect_key_file(passfile, kind="pass"))):
        both_ok = both_ok and state.state == "ok"
        report(state.state == "ok", f"kunci pemilik: {label} berkas biasa (bukan symlink) dan terbaca uid {euid}",
               "terbaca" if state.state == "ok" else f"{state.state}: {state.detail}")
    if not both_ok:
        return
    home = _key_home()
    out = run(["keytool", "-list", "-v", "-alias", ALIAS, "-keystore", p12, "-storetype", "PKCS12", "-storepass:file", passfile,
               "-J-Xmx128m", f"-J-Duser.home={home}", "-J-Duser.language=en"], env={**os.environ, "HOME": home})
    text = out.stdout or ""
    entry = re.search(r"(?m)^Entry type:\s*(\S+)", text)
    entry_type = entry.group(1) if entry else ""
    if out.returncode != 0:
        report(False, f"kunci pemilik: keytool -list -v membaca keystore (alias {ALIAS})", tail(out, 1))
    else:
        report(entry_type == "PrivateKeyEntry", f"kunci pemilik: alias {ALIAS} bertipe PrivateKeyEntry", f"tipe entri: {entry_type or 'tidak terbaca'}")
        listed = re.search(r"(?m)^\s*SHA-?256:\s*((?:[0-9A-Fa-f]{2}:){31}[0-9A-Fa-f]{2})\s*$", text)
        listed_hex = listed.group(1).replace(":", "").lower() if listed else ""
        state, value = owner_fingerprint(p12, passfile, _keytool_run, home=home)
        same = state == "ok" and bool(listed_hex) and value == listed_hex
        report(same, "kunci pemilik: sidik jari SHA-256 sama dari dua cara (DER -exportcert dan teks -list -v)",
               f"{value[:12]}…" if same else f"berbeda atau tidak terbaca (DER: {value[:12] if state == 'ok' else state}; teks: {listed_hex[:12] or 'tidak ada'})")
    check_output_has_no_password(passfile)


def load_pattern(pw_path: str | None = None) -> bytes | None:
    """Isi berkas sandi (tanpa \\r\\n akhir) sebagai pola pencarian; None bila tidak terbaca atau terlalu pendek. Isinya tidak pernah dicetak."""
    data = read_small(pw_path or PASS_PATH, 258)
    if data is None:
        return None
    pw = data.rstrip(b"\r\n")
    return pw if len(pw) >= MIN_PATTERN else None


def check_output_has_no_password(pw_path: str) -> None:
    raw = read_small(pw_path, 258)
    if raw is None:
        return
    pattern = load_pattern(pw_path)
    if pattern is None:
        skip("keluaran selftest tidak memuat kata sandi: berkas sandi terlalu pendek untuk diperiksa secara bermakna")
        return
    report(pattern not in "\n".join(printed).encode("utf-8", errors="replace"), "keluaran selftest tidak memuat kata sandi", f"{len(printed)} baris diperiksa")


# ---------------------------------------------------------------- pemindai /proc (--leak-scan, --watch); murni, /proc disuntik untuk tes
def _pids(proc_root: str) -> list[str]:
    try:
        return sorted(n for n in os.listdir(proc_root) if n.isdigit())
    except OSError:
        return []


def scan_proc(proc_root: str, pattern: bytes) -> tuple[int, list[str]]:
    """Potret satu kali: (jumlah berkas environ/cmdline yang terbaca, daftar 'pid/berkas' yang memuat pola). Berkas tak terbaca (uid lain) tidak dihitung."""
    checked, leaks = 0, []
    for pid in _pids(proc_root):
        for name in ("environ", "cmdline"):
            data = read_small(os.path.join(proc_root, pid, name), PROC_READ_LIMIT)
            if data is None:
                continue
            checked += 1
            if pattern in data:
                leaks.append(f"{pid}/{name}")
    return checked, leaks


def classify_cmdline(cmdline: bytes) -> set[str]:
    """Alat penanda tangan apa yang ada di argv ini (apksigner berjalan sebagai JVM: `java ... -jar apksigner.jar`)."""
    args = [a.decode("utf-8", errors="replace") for a in cmdline.split(b"\0") if a]
    if not args:
        return set()
    base = os.path.basename(args[0])
    names = {os.path.basename(a) for a in args}
    found = set()
    if "apksigner.jar" in names or base == "apksigner" or (base in ("sh", "bash", "dash") and "apksigner" in names):
        found.add("apksigner")
    if base == "zipalign":
        found.add("zipalign")
    if base == "keytool" or (base == "java" and any(a.endswith("keytool.Main") for a in args)):
        found.add("keytool")
    return found


def _cgroup_sample(cgroup_root: str) -> tuple[int | None, int | None]:
    """(anon+shmem dalam byte, oom_kill) dari cgroup v2; None bila tidak terbaca."""
    anon = oom = None
    raw = read_small(os.path.join(cgroup_root, "memory.stat"), 64 * 1024)
    if raw is not None:
        fields = {}
        for line in raw.decode("utf-8", errors="replace").splitlines():
            key, _, value = line.partition(" ")
            if value.strip().isdigit():
                fields[key] = int(value)
        if "anon" in fields:
            anon = fields["anon"] + fields.get("shmem", 0)
    raw = read_small(os.path.join(cgroup_root, "memory.events"), 64 * 1024)
    if raw is not None:
        for line in raw.decode("utf-8", errors="replace").splitlines():
            key, _, value = line.partition(" ")
            if key == "oom_kill" and value.strip().isdigit():
                oom = int(value)
    return anon, oom


def _stdin_eof(stream) -> bool:  # noqa: ANN001
    """True bila stdin sudah EOF (ujung tulis FIFO ditutup: skrip pemanggil mati). Tanpa fileno yang valid -> False."""
    if stream is None:
        return False
    try:
        fd = stream.fileno()
        ready, _, _ = select.select([fd], [], [], 0)
        return bool(ready) and os.read(fd, 4096) == b""
    except (OSError, ValueError, AttributeError):
        return False


def watch(seconds: float, *, pattern: bytes, proc_root: str | None = None, cgroup_root: str | None = None, tmp_root: str | None = None,
          stop_file: str | None = None, stdin=None, interval: float = WATCH_INTERVAL, sleep=time.sleep, clock=time.monotonic) -> dict[str, object]:  # noqa: ANN001
    """Pemotret berkelanjutan. Berhenti oleh `seconds` habis, EOF `stdin`, atau `stop_file`. Selalu mengambil minimal satu sampel.
    `oom_kill` = selisih terhadap sampel pertama (kejadian SELAMA pemantauan; riwayat lama kontainer tidak dihitung)."""
    proc_root, cgroup_root = proc_root or PROC_ROOT, cgroup_root or CGROUP_ROOT
    tmp_root, stop_file = tmp_root or TMP_ROOT, stop_file or STOP_FILE
    samples = leaked_samples = 0
    argv_seen = {"apksigner": 0, "zipalign": 0, "keytool": 0}
    anon_peak: int | None = None
    oom_first = oom_last = None
    end = clock() + seconds
    while True:
        samples += 1
        leaked, tools = False, set()
        for pid in _pids(proc_root):
            cmd = read_small(os.path.join(proc_root, pid, "cmdline"), PROC_READ_LIMIT)
            if cmd is not None:
                leaked = leaked or pattern in cmd
                tools |= classify_cmdline(cmd)
            env = read_small(os.path.join(proc_root, pid, "environ"), PROC_READ_LIMIT)
            leaked = leaked or (env is not None and pattern in env)
        for path in glob.glob(os.path.join(tmp_root, "hsperfdata_*", "*")):
            data = read_small(path, PROC_READ_LIMIT)
            leaked = leaked or (data is not None and pattern in data)
        leaked_samples += leaked
        for tool in tools:
            argv_seen[tool] += 1
        anon, oom = _cgroup_sample(cgroup_root)
        if anon is not None:
            anon_peak = anon if anon_peak is None else max(anon_peak, anon)
        if oom is not None:
            oom_first = oom if oom_first is None else oom_first
            oom_last = oom
        if clock() >= end or os.path.lexists(stop_file) or _stdin_eof(stdin):
            break
        sleep(interval)
    peak_raw = read_small(os.path.join(cgroup_root, "memory.peak"), 64)
    peak_txt = peak_raw.strip().decode("ascii", errors="replace") if peak_raw else ""
    return {
        "samples": samples, "argv_apksigner": argv_seen["apksigner"], "argv_zipalign": argv_seen["zipalign"], "argv_keytool": argv_seen["keytool"],
        "bocor": leaked_samples, "anon_peak_mib": "-" if anon_peak is None else anon_peak // MIB,
        "oom_kill": "-" if oom_last is None else max(0, oom_last - (oom_first or 0)),
        "memory_peak": f"{int(peak_txt) // MIB} MiB" if peak_txt.isdigit() else "tidak tersedia",
    }


WATCH_KEYS = ("samples", "argv_apksigner", "argv_zipalign", "argv_keytool", "bocor", "anon_peak_mib", "oom_kill", "memory_peak")


def watch_verdict(result: dict[str, object]) -> tuple[str, str]:
    """('OK'|'GAGAL'|'tidak terbukti', alasan). Tanpa satu pun sampel yang melihat argv apksigner, 'tidak ada kebocoran' TIDAK terbukti (bukan OK)."""
    if int(result["bocor"]) > 0:  # type: ignore[call-overload]
        return "GAGAL", f"kata sandi terlihat di {result['bocor']} sampel"
    if int(result["argv_apksigner"]) == 0:  # type: ignore[call-overload]
        return "tidak terbukti", "pemotret tidak sempat melihat argv alat penanda tangan"
    return "OK", f"{result['samples']} sampel, argv apksigner teramati {result['argv_apksigner']} kali, tanpa kata sandi"


# ---------------------------------------------------------------- --check-apk (Tahap 2b, FEAT G): verifikasi independen artefak build
OUTPUT_NAME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,119}")        # sama dengan rvcore.store._OUTPUT_NAME_RE (dijaga tes)
CHECK_TIMEOUT = 600
CHECK_CHUNK = MIB
CHECK_OPEN_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC | os.O_NOCTTY    # NONBLOCK: FIFO tidak menggantung
CHECK_KEYS = ("signers", "v2", "v3", "cert", "zipalign", "sha", "size")
_CHECK_SCHEME_RE = re.compile(r"^Verified using v(1|2|3) scheme \(.*\): (true|false)\s*$", re.M)
_CHECK_SIGNERS_RE = re.compile(r"^Number of signers: (\d+)\s*$", re.M)
_CHECK_DIGEST_RE = re.compile(r"^(?:Signer #\d+|V\d(?:\.\d)?)[^\n]*?certificate SHA-256 digest: ([0-9a-fA-F]{64})\s*$", re.M)   # bukan 'public key SHA-256'


class CheckUsage(Exception):
    pass


class CheckFail(Exception):
    def __init__(self, kode: str, alasan: str) -> None:
        super().__init__(alasan)
        self.kode, self.alasan = kode, alasan


def _check_id(label: str, text: str) -> str:
    if not (text.isascii() and text.isdigit()) or len(text) > 9 or not 1 <= int(text) <= MAX_PROTO_ID:
        raise CheckUsage(f"{label} harus bilangan bulat 1..{MAX_PROTO_ID}")
    return str(int(text))


def _check_line(text: object) -> str:
    return "".join(ch if ch.isprintable() else " " for ch in str(text)).strip()[:300]


def _open_apk(builds_root: str, aid: str, bid: str, name: str) -> tuple[int, int]:
    """(fd folder build, fd berkas) lewat rantai O_NOFOLLOW; berkas harus biasa dan tidak kosong. Pemanggil menutup keduanya."""
    try:
        dfd = open_dir_chain(builds_root, aid, bid)
    except OSError as exc:
        if exc.errno in (errno.ENOENT, errno.ELOOP, errno.ENOTDIR):
            raise CheckFail("berkas_tidak_ada", f"folder build {aid}/{bid} tidak ada atau bukan direktori biasa") from None
        raise CheckFail("tidak_terbaca", f"folder build tidak bisa dibuka ({errno.errorcode.get(exc.errno or 0, 'galat')})") from None
    try:
        fd = os.open(name, CHECK_OPEN_FLAGS, dir_fd=dfd)
    except OSError as exc:
        os.close(dfd)
        if exc.errno in (errno.ENOENT, errno.ELOOP, errno.ENOTDIR, errno.EISDIR, errno.ENXIO):
            raise CheckFail("berkas_tidak_ada", f"{name} tidak ada atau bukan berkas biasa") from None
        raise CheckFail("tidak_terbaca", f"{name} tidak bisa dibuka ({errno.errorcode.get(exc.errno or 0, 'galat')})") from None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size <= 0:
            raise CheckFail("berkas_tidak_ada", f"{name} bukan berkas biasa yang berisi")
    except BaseException:
        os.close(fd)
        os.close(dfd)
        raise
    return dfd, fd


def _hash_fd(fd: int) -> tuple[str, int]:
    digest, total = hashlib.sha256(), 0
    while True:
        chunk = os.read(fd, CHECK_CHUNK)
        if not chunk:
            return digest.hexdigest(), total
        digest.update(chunk)
        total += len(chunk)


def _run_tool(argv: list[str]) -> tuple[int, str]:
    try:
        proc = subprocess.run(argv, capture_output=True, timeout=CHECK_TIMEOUT, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        raise CheckFail("alat_waktu_habis", f"{argv[0]} melewati {CHECK_TIMEOUT} dtk") from None
    except OSError as exc:
        raise CheckFail("alat_gagal", f"{argv[0]} tidak dapat dijalankan ({errno.errorcode.get(exc.errno or 0, 'galat')})") from None
    return proc.returncode, (proc.stdout + proc.stderr).decode("utf-8", errors="replace")


def run_check_apk(argv: list[str], *, builds_root: str | None = None) -> int:
    """Lihat docstring modul. `builds_root` hanya untuk tes (bawaan `<DATA_DIR>/builds`)."""
    try:
        if len(argv) != 3:
            raise CheckUsage("pemakaian: signer-selftest --check-apk <analysis_id> <build_id> <nama>")
        aid, bid, name = _check_id("analysis_id", argv[0]), _check_id("build_id", argv[1]), argv[2]
        if not OUTPUT_NAME_RE.fullmatch(name):
            raise CheckUsage("nama berkas harus lolos ^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$")
    except CheckUsage as exc:
        print(f"GALAT: {exc}", file=sys.stderr)
        return 64
    root = builds_root if builds_root is not None else os.path.join(DATA_DIR, "builds")
    path = os.path.join(root, aid, bid, name)
    dfd = fd = -1
    result: dict[str, str] = {}
    failure: CheckFail | None = None
    try:
        dfd, fd = _open_apk(root, aid, bid, name)
        before = os.fstat(fd)
        sha, size = _hash_fd(fd)
        a_rc, _ = _run_tool(["zipalign", "-c", "-P", "16", "4", path])
        v_rc, v_text = _run_tool(["apksigner", "verify", "--verbose", "--print-certs", path])
        try:
            now = os.stat(name, dir_fd=dfd, follow_symlinks=False)
        except OSError:
            raise CheckFail("berubah", "berkas hilang/berganti selama pemeriksaan") from None
        if (now.st_ino, now.st_dev, now.st_size) != (before.st_ino, before.st_dev, before.st_size) or size != before.st_size:
            raise CheckFail("berubah", "berkas berganti atau berubah ukuran selama pemeriksaan")
        schemes = {m.group(1): m.group(2) == "true" for m in _CHECK_SCHEME_RE.finditer(v_text)}
        count = _CHECK_SIGNERS_RE.search(v_text)
        digests = sorted({m.group(1).lower() for m in _CHECK_DIGEST_RE.finditer(v_text)})
        result = {"signers": count.group(1) if count else "-", "v2": "1" if schemes.get("2") else "0", "v3": "1" if schemes.get("3") else "0",
                  "cert": ",".join(digests) or "-", "zipalign": "ok" if a_rc == 0 else "gagal", "sha": sha, "size": str(size)}
        if a_rc != 0:
            failure = CheckFail("zipalign_gagal", f"zipalign -c kode {a_rc}")
        elif v_rc != 0:
            failure = CheckFail("verify_gagal", f"apksigner verify kode {v_rc}")
    except CheckFail as exc:
        failure = exc
    except Exception as exc:  # noqa: BLE001 - mode ini tidak boleh menumpahkan traceback; jenis galat saja
        failure = CheckFail("internal", type(exc).__name__)
    finally:
        for h in (fd, dfd):
            if h >= 0:
                os.close(h)
    for key in CHECK_KEYS:
        if key in result:
            print(f"{key}={_check_line(result[key])}")
    if failure is not None:
        print(f"kode={failure.kode}")
        print(f"alasan={_check_line(failure.alasan)}")
        return 3
    return 0


# ---------------------------------------------------------------- --check-bundle (Tahap 3): verifikasi independen paket XAPK/APKS
BUNDLE_FORMATS = {".xapk": "xapk", ".apks": "apks"}
BUNDLE_ENTRY_KEYS = ("signers", "v2", "v3", "cert", "zipalign", "sisa_ttd")
_BAD_NAME_CHARS = re.compile(r"[\x00-\x1f\x7f\\]")


def _bundle_name_ok(name: str) -> bool:
    """Nama entri paket aman: bukan mutlak, tanpa kontrol/backslash, tanpa komponen kosong/`.`/`..` (entri direktori berakhiran `/`). Nama TIDAK pernah menjadi path."""
    if not name or name.startswith("/") or _BAD_NAME_CHARS.search(name):
        return False
    parts = name[:-1].split("/") if name.endswith("/") else name.split("/")
    return all(part not in ("", ".", "..") for part in parts)


def _bundle_plan(fd: int) -> tuple[zipfile.ZipFile, list[zipfile.ZipInfo], int]:
    """Buka paket dari fd yang sama, validasi seluruh central directory SEBELUM mengekstrak: -> (ZipFile, entri APK berurutan, jumlah extras). CheckFail(bukan_paket)."""
    try:
        splitzip.checked_entry_names(fd, ZIP_MAX_ENTRIES)           # pagar DoS: jumlah entri/ukuran CD dibatasi sebelum zipfile memuat semuanya
        zf = zipfile.ZipFile(os.fdopen(os.dup(fd), "rb"))
        infos = zf.infolist()
    except (zipfile.BadZipFile, zipfile.LargeZipFile, OSError, RuntimeError, ValueError, NotImplementedError, EOFError) as exc:
        raise CheckFail("bukan_paket", f"bukan paket ZIP yang sah ({type(exc).__name__}: {_check_line(exc)})") from None
    try:
        if len(infos) > ZIP_MAX_ENTRIES:
            raise CheckFail("bukan_paket", f"jumlah entri {len(infos)} melebihi batas {ZIP_MAX_ENTRIES}")
        folded: set[str] = set()
        apks: list[zipfile.ZipInfo] = []
        extras = 0
        for info in infos:
            if not _bundle_name_ok(info.filename):
                raise CheckFail("bukan_paket", "ada nama entri yang tidak aman (mutlak, '..', backslash, atau karakter kontrol)")
            key = info.filename.casefold()
            if key in folded:
                raise CheckFail("bukan_paket", "ada nama entri ganda (dilipat huruf)")
            folded.add(key)
            if info.is_dir():
                continue
            if info.flag_bits & 0x1 or info.compress_type not in (zipfile.ZIP_STORED, zipfile.ZIP_DEFLATED):
                raise CheckFail("bukan_paket", "entri terenkripsi atau berkompresi tak umum")
            if key.endswith(".apk"):
                apks.append(info)
            else:
                extras += 1
        if not apks:
            raise CheckFail("bukan_paket", "paket tidak memuat entri .apk")
        if len(apks) > MAX_BUNDLE_APKS:
            raise CheckFail("bukan_paket", f"jumlah APK {len(apks)} melebihi batas {MAX_BUNDLE_APKS}")
        if any(i.file_size > ZIP_MAX_ENTRY_BYTES for i in apks):
            raise CheckFail("bukan_paket", "ada APK di dalam paket yang melebihi batas ukuran per entri")
        if sum(i.file_size for i in apks) > ZIP_MAX_TOTAL_BYTES:
            raise CheckFail("bukan_paket", "total ukuran APK di dalam paket melebihi batas")
    except BaseException:
        zf.close()
        raise
    return zf, apks, extras


def _extract_apk(zf: zipfile.ZipFile, info: zipfile.ZipInfo, sfd: int, ename: str) -> None:
    """Ekstrak SATU entri APK ke `ename` (nama buatan sendiri) di subfolder privat: O_EXCL|O_NOFOLLOW 0600 lewat dir_fd; byte nyata tidak boleh melebihi ukuran terdeklarasi."""
    fd = os.open(ename, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=sfd)
    total = 0
    try:
        with zf.open(info) as src:
            while True:
                chunk = src.read(CHECK_CHUNK)
                if not chunk:
                    break
                total += len(chunk)
                if total > info.file_size:
                    raise CheckFail("bukan_paket", "isi entri APK melebihi ukuran terdeklarasi")
                view = memoryview(chunk)
                while view:
                    view = view[os.write(fd, view):]
    except (zipfile.BadZipFile, zlib.error, EOFError, NotImplementedError, RuntimeError) as exc:
        raise CheckFail("bukan_paket", f"entri APK rusak ({type(exc).__name__})") from None
    finally:
        os.close(fd)
    if total != info.file_size:
        raise CheckFail("bukan_paket", "isi entri APK lebih pendek dari ukuran terdeklarasi")


def _leftover_count(sfd: int, ename: str) -> str:
    """Jumlah berkas tanda tangan di luar himpunan boleh apksigner pada APK yang diekstrak; `-` bila tak terbaca sebagai ZIP."""
    try:
        fd = os.open(ename, CHECK_OPEN_FLAGS, dir_fd=sfd)
    except OSError:
        return "-"
    try:
        return str(len(splitzip.unexpected_signature_entries(splitzip.checked_entry_names(fd, ZIP_MAX_ENTRIES))))
    except (zipfile.BadZipFile, OSError, RuntimeError, ValueError):
        return "-"
    finally:
        os.close(fd)


def run_check_bundle(argv: list[str], *, builds_root: str | None = None, work_root: str | None = None) -> int:
    """Lihat docstring modul. `builds_root`/`work_root` hanya untuk tes (bawaan `<DATA_DIR>/builds`, `<DATA_DIR>/signwork`)."""
    try:
        if len(argv) != 3:
            raise CheckUsage("pemakaian: signer-selftest --check-bundle <analysis_id> <build_id> <nama>")
        aid, bid, name = _check_id("analysis_id", argv[0]), _check_id("build_id", argv[1]), argv[2]
        if not OUTPUT_NAME_RE.fullmatch(name):
            raise CheckUsage("nama berkas harus lolos ^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$")
    except CheckUsage as exc:
        print(f"GALAT: {exc}", file=sys.stderr)
        return 64
    root = builds_root if builds_root is not None else os.path.join(DATA_DIR, "builds")
    work = work_root if work_root is not None else os.path.join(DATA_DIR, "signwork")
    fmt = BUNDLE_FORMATS.get(os.path.splitext(name)[1])
    dfd = fd = wfd = sfd = -1
    sub: str | None = None
    zf: zipfile.ZipFile | None = None
    header: list[tuple[str, str]] = []
    entries: list[dict[str, str]] = []
    tail: list[tuple[str, str]] = []
    failure: CheckFail | None = None
    try:
        if fmt is None:
            raise CheckFail("bukan_paket", "nama paket harus berakhiran .xapk atau .apks")
        dfd, fd = _open_apk(root, aid, bid, name)
        if os.fstat(fd).st_nlink != 1:
            raise CheckFail("bukan_paket", "paket punya tautan keras lain (nlink != 1)")
        zf, apks, extras = _bundle_plan(fd)
        header = [("format", fmt), ("entri_apk", str(len(apks)))]
        try:
            wfd = os.open(work, DIR_FLAGS)
        except OSError as exc:
            raise CheckFail("internal", f"ruang kerja signwork tidak bisa dibuka ({errno.errorcode.get(exc.errno or 0, 'galat')})") from None
        fresh = ".check-" + secrets.token_hex(8)
        try:
            os.mkdir(fresh, 0o700, dir_fd=wfd)                              # sudah ada (EEXIST, termasuk symlink) -> gagal-tertutup, TIDAK dihapus/dipakai
        except OSError as exc:
            raise CheckFail("internal", f"subfolder kerja tidak bisa dibuat ({errno.errorcode.get(exc.errno or 0, 'galat')})") from None
        sub = fresh
        try:
            sfd = os.open(sub, DIR_FLAGS, dir_fd=wfd)
        except OSError as exc:
            raise CheckFail("internal", f"subfolder kerja tidak bisa dibuka ({errno.errorcode.get(exc.errno or 0, 'galat')})") from None
        certs: set[str] = set()
        for n, info in enumerate(apks, 1):
            ename = f"e{n:03d}.apk"
            _extract_apk(zf, info, sfd, ename)
            path = os.path.join(work, sub, ename)
            a_rc, _ = _run_tool(["zipalign", "-c", "-P", "16", "4", path])
            v_rc, v_text = _run_tool(["apksigner", "verify", "--verbose", "--print-certs", path])
            schemes = {m.group(1): m.group(2) == "true" for m in _CHECK_SCHEME_RE.finditer(v_text)}
            count = _CHECK_SIGNERS_RE.search(v_text)
            digests = sorted({m.group(1).lower() for m in _CHECK_DIGEST_RE.finditer(v_text)})
            certs.update(digests)
            entries.append({"nama": info.filename, "signers": count.group(1) if count else "-", "v2": "1" if schemes.get("2") else "0",
                            "v3": "1" if schemes.get("3") else "0", "cert": ",".join(digests) or "-", "zipalign": "ok" if a_rc == 0 else "gagal",
                            "sisa_ttd": _leftover_count(sfd, ename)})
            os.unlink(ename, dir_fd=sfd)                                   # puncak disk = satu APK, bukan jumlahnya
            if failure is None and a_rc != 0:
                failure = CheckFail("zipalign_gagal", f"zipalign -c kode {a_rc} pada entri {n}")
            elif failure is None and v_rc != 0:
                failure = CheckFail("verify_gagal", f"apksigner verify kode {v_rc} pada entri {n}")
        tail = [("cert_berbeda", str(len(certs))), ("extras_n", str(extras))]
    except CheckFail as exc:
        failure = exc
    except Exception as exc:  # noqa: BLE001 - mode ini tidak boleh menumpahkan traceback; jenis galat saja
        failure = CheckFail("internal", type(exc).__name__)
    finally:
        if zf is not None:
            zf.close()
        if sfd >= 0:
            os.close(sfd)
        if wfd >= 0:
            if sub is not None:
                try:
                    rmtree_at(wfd, sub)
                except OSError:
                    pass
            os.close(wfd)
        for h in (fd, dfd):
            if h >= 0:
                os.close(h)
    for key, value in header:
        print(f"{key}={_check_line(value)}")
    for n, entry in enumerate(entries, 1):
        print(f"entri.{n}.nama={_check_line(entry['nama'])}")
        for key in BUNDLE_ENTRY_KEYS:
            print(f"entri.{n}.{key}={_check_line(entry[key])}")
    for key, value in tail:
        print(f"{key}={_check_line(value)}")
    if failure is not None:
        print(f"kode={failure.kode}")
        print(f"alasan={_check_line(failure.alasan)}")
        return 3
    return 0


def run_leak_scan(proc_root: str | None = None, pw_path: str | None = None) -> int:
    pattern = load_pattern(pw_path)
    if pattern is None:
        print(f"GALAT: pola tidak tersedia (berkas sandi {pw_path or PASS_PATH} tidak terbaca atau lebih pendek dari {MIN_PATTERN} karakter)", file=sys.stderr)
        return 2
    checked, leaks = scan_proc(proc_root or PROC_ROOT, pattern)
    print(f"diperiksa={checked}")
    print(f"bocor={len(leaks)}")
    if leaks:
        print("kata sandi terlihat di: " + ", ".join(leaks[:10]), file=sys.stderr)
        return 1
    return 0


def run_watch(seconds: float, *, pw_path: str | None = None, stdin=None, **kwargs) -> int:  # noqa: ANN001, ANN003
    pattern = load_pattern(pw_path)
    if pattern is None:
        print(f"GALAT: pola tidak tersedia (berkas sandi {pw_path or PASS_PATH} tidak terbaca atau lebih pendek dari {MIN_PATTERN} karakter)", file=sys.stderr)
        return 2
    result = watch(seconds, pattern=pattern, stdin=stdin, **kwargs)
    for key in WATCH_KEYS:
        print(f"{key}={result[key]}")
    sys.stdout.flush()
    state, why = watch_verdict(result)
    print(f"[ -- ] {state} — {why}", file=sys.stderr)
    return 0


def check_isolation() -> None:
    report(os.geteuid() != 0, "bukan root", f"uid={os.geteuid()}")

    # Rootfs read-only dibaca dari opsi mount, BUKAN dengan mencoba menulis: user non-root memang tak boleh menulis ke /.
    root_opts = None
    with open("/proc/self/mountinfo") as fh:
        for line in fh:
            parts = line.split()
            if len(parts) > 5 and parts[4] == "/":
                root_opts = parts[5].split(",")
                break
    report(root_opts is not None and "ro" in root_opts, "rootfs read-only",
           "mount / opsi: " + (",".join(root_opts) if root_opts else "tidak ditemukan"))

    try:
        probe = os.path.join(os.environ.get("HOME", "/tmp/home"), "probe")
        os.makedirs(os.path.dirname(probe), exist_ok=True)
        with open(probe, "w"):
            pass
        os.remove(probe)
        report(True, "/tmp dapat ditulis", "tmpfs tersedia untuk kerja alat")
    except OSError as exc:
        report(False, "/tmp dapat ditulis", str(exc))

    reachable = False
    for host in ("1.1.1.1", "8.8.8.8"):
        try:
            with socket.create_connection((host, 443), timeout=3):
                reachable = True
                break
        except OSError:
            pass
    report(not reachable, "jaringan terisolasi", "koneksi keluar gagal (benar)" if not reachable else "internet TERJANGKAU")

    bad = sorted(k for k in os.environ if any(t in k.upper() for t in SECRET_ENV))
    report(not bad, "environment tanpa rahasia", "tidak ada variabel bernuansa rahasia" if not bad else "ADA: " + ", ".join(bad))

    keys = find_keystores("/")
    report(not keys, "tidak ada keystore LAIN di image/FS di luar /run/secrets", "tidak ada" if not keys else "DITEMUKAN: " + ", ".join(keys[:5]))
    ok, detail = check_secrets_dir()
    report(ok, "/run/secrets hanya berisi tepat {signing_keystore, signing_keystore_pass} bila dipasang, atau tidak ada/kosong", detail)
    ok, detail = check_data_dir()
    report(ok, "/data hanya berisi builds, signspool, dan signwork, akar ketiganya dapat ditulis uid 10001", detail)


def check_toolchain() -> None:
    base = os.environ.get("HOME", "/tmp/home")
    os.makedirs(base, exist_ok=True)
    work = tempfile.mkdtemp(prefix="selftest-", dir=base)
    try:
        _toolchain(work)
    except Exception as exc:  # noqa: BLE001
        report(False, "rantai tanda tangan", f"{type(exc).__name__}: {exc}")
    finally:
        shutil.rmtree(work, ignore_errors=True)
    report(not os.path.exists(work), "keystore sementara terhapus", "direktori kerja dihapus" if not os.path.exists(work) else work)


def _toolchain(work: str) -> None:
    def p(n: str) -> str:
        return os.path.join(work, n)

    pw = secrets.token_urlsafe(24)
    env = {**os.environ, "SELFTEST_PW": pw, "HOME": work}

    # Keystore sementara (PKCS12, RSA 2048, berlaku 2 hari). Kata sandi hanya lewat ENV, tak pernah di argv.
    out = run(["keytool", "-genkeypair", "-keystore", p("ks.p12"), "-storetype", "PKCS12", "-alias", "selftest",
               "-keyalg", "RSA", "-keysize", "2048", "-validity", "2", "-dname", "CN=signer-selftest",
               "-storepass:env", "SELFTEST_PW", "-keypass:env", "SELFTEST_PW",
               f"-J-Duser.home={work}", "-J-Xmx128m"], env=env)
    report(out.returncode == 0 and os.path.exists(p("ks.p12")), "keytool membuat keystore sementara", "PKCS12 RSA-2048, kata sandi acak lewat ENV" if out.returncode == 0 else tail(out, 1))
    if out.returncode != 0:
        return

    # zipalign: kontrol positif. ZIP tak selaras HARUS ditolak -c, lalu diperbaiki -f.
    make_test_apk(p("misaligned.apk"), misaligned=True)
    odd = [n for n, off in stored_data_offsets(p("misaligned.apk")).items() if off % 4]
    chk = run(["zipalign", "-c", "-P", "16", "4", p("misaligned.apk")])
    report(bool(odd) and chk.returncode != 0, "zipalign -c menolak ZIP tak selaras", f"entri ganjil: {len(odd)}; kode {chk.returncode}")
    fix = run(["zipalign", "-P", "16", "-f", "4", p("misaligned.apk"), p("fixed.apk")])
    chk = run(["zipalign", "-c", "-P", "16", "4", p("fixed.apk")])
    report(fix.returncode == 0 and chk.returncode == 0, "zipalign -f memperbaiki, -c lulus", f"kode {fix.returncode}/{chk.returncode}")

    # Rantai utama: zipalign -> sign -> verify. minSdk 24 supaya apksigner tidak mem-parse manifest sintetis (bukan AXML);
    # konsekuensinya tanda tangan v1 tidak dibuat, jadi yang dinilai v2 dan v3 (cukup untuk API 24+).
    make_test_apk(p("in.apk"))
    out = run(["zipalign", "-P", "16", "-f", "4", p("in.apk"), p("aligned.apk")])
    chk = run(["zipalign", "-c", "-P", "16", "4", p("aligned.apk")])
    report(out.returncode == 0 and chk.returncode == 0, "zipalign APK uji", f"kode {out.returncode}/{chk.returncode}")

    out = run(["apksigner", "sign", "--ks", p("ks.p12"), "--ks-key-alias", "selftest", "--ks-pass", "env:SELFTEST_PW",
               "--key-pass", "env:SELFTEST_PW", "--min-sdk-version", "24", "--out", p("signed.apk"), p("aligned.apk")], env=env)
    report(out.returncode == 0 and os.path.exists(p("signed.apk")), "apksigner sign", tail(out, 1) if out.returncode else "signed.apk dibuat")
    if out.returncode != 0:
        return

    ver = run(["apksigner", "verify", "--verbose", "--print-certs", "--min-sdk-version", "24", p("signed.apk")])
    text = ver.stdout + ver.stderr
    v2 = re.search(r"APK Signature Scheme v2\): true", text) is not None
    v3 = re.search(r"APK Signature Scheme v3\): true", text) is not None
    report(ver.returncode == 0 and v2 and v3 and "CN=signer-selftest" in text, "apksigner verify lulus (v2 dan v3)",
           f"kode {ver.returncode}; v2={v2} v3={v3}")

    # Tes negatif: keduanya HARUS ditolak. Dilaporkan OK hanya bila benar-benar ditolak.
    neg = run(["apksigner", "verify", "--min-sdk-version", "24", p("aligned.apk")])
    rejected = neg.returncode != 0 and "DOES NOT VERIFY" in (neg.stdout + neg.stderr)
    report(rejected, "negatif: APK tanpa tanda tangan ditolak", f"kode {neg.returncode}; " + tail(neg, 1))

    tamper(p("signed.apk"), p("tampered.apk"))
    neg = run(["apksigner", "verify", "--min-sdk-version", "24", p("tampered.apk")])
    rejected = neg.returncode != 0 and "DOES NOT VERIFY" in (neg.stdout + neg.stderr)
    report(rejected, "negatif: APK yang dirusak setelah ditandatangani ditolak", f"kode {neg.returncode}; " + tail(neg, 1))


def main(argv: list[str] | None = None) -> int:
    global failed
    failed = False
    counts.update(ok=0, gagal=0, skip=0)
    printed.clear()
    args = sys.argv[1:] if argv is None else argv
    toolchain_only = "--toolchain-only" in args

    if "--check-apk" in args:
        at = args.index("--check-apk")
        if any(a in args for a in ("--leak-scan", "--watch", "--toolchain-only", "--check-bundle")):
            print("GALAT: --check-apk tidak boleh dipakai bersama mode lain", file=sys.stderr)
            return 64
        return run_check_apk(args[at + 1:])

    if "--check-bundle" in args:
        at = args.index("--check-bundle")
        if any(a in args for a in ("--leak-scan", "--watch", "--toolchain-only")):
            print("GALAT: --check-bundle tidak boleh dipakai bersama mode lain", file=sys.stderr)
            return 64
        return run_check_bundle(args[at + 1:])

    if "--leak-scan" in args or "--watch" in args:
        if "--leak-scan" in args and "--watch" in args:
            print("GALAT: --leak-scan dan --watch tidak boleh dipakai bersamaan", file=sys.stderr)
            return 64
        if "--leak-scan" in args:
            return run_leak_scan()
        at = args.index("--watch")
        seconds = WATCH_DEFAULT_SEC
        if at + 1 < len(args) and not args[at + 1].startswith("--"):
            if not args[at + 1].isdigit() or int(args[at + 1]) < 1:
                print("GALAT: --watch butuh bilangan bulat detik > 0", file=sys.stderr)
                return 64
            seconds = int(args[at + 1])
        return run_watch(seconds, stdin=sys.stdin)

    os.makedirs(os.environ.get("HOME", "/tmp/home"), exist_ok=True)

    check_tools()
    if toolchain_only:
        info("bagian isolasi kontainer DILEWATI", "--toolchain-only")
    else:
        check_isolation()
    check_keystore()
    check_toolchain()
    print(f"ringkasan: {counts['ok']} OK, {counts['gagal']} GAGAL, {counts['skip']} DILEWATI")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
