class Verify(NamedTuple):
    rc: int | None
    v1: bool
    v2: bool
    v3: bool
    signer_count: int | None
    digests: tuple[str, ...]


def parse_verify(rc: int | None, text: str) -> Verify:
    """Parse keluaran `apksigner verify --verbose --print-certs` (berjangkar; keluaran tak dikenal -> semua false/kosong)."""
    schemes = {m.group(1): m.group(2) == "true" for m in _SCHEME_RE.finditer(text)}
    count = _SIGNERS_RE.search(text)
    digests = tuple(m.group(1).lower() for m in _DIGEST_RE.finditer(text))
    return Verify(rc, schemes.get("1", False), schemes.get("2", False), schemes.get("3", False), int(count.group(1)) if count else None, digests)


def evaluate_verify(verify: Verify, owner_sha: str) -> tuple[bool, str | None, str]:
    """(ok, error_code, error_text). Lulus bila rc==0, v2 dan v3 true, tepat satu penanda tangan, dan SEMUA digest sertifikat == sidik jari pemilik.
    Digest berbeda -> cert_mismatch; selain itu verify_failed. v1 informatif."""
    if verify.rc != 0 or not (verify.v2 and verify.v3) or not verify.digests:
        return False, "verify_failed", ERROR_TEXT["verify_failed"]
    owner = owner_sha.lower()
    if set(verify.digests) != {owner}:
        got = ", ".join(sorted({d[:12] for d in verify.digests if d != owner}))
        return False, "cert_mismatch", f"sertifikat penanda tangan ({got}…) tidak sama dengan keystore pemilik ({owner[:12]}…); hasil dibuang"
    if verify.signer_count != 1:
        return False, "verify_failed", f"jumlah penanda tangan {verify.signer_count}, seharusnya 1"
    return True, None, ""


def sha256_fd(fd: int, on_tick: Callable[[], None] | None = None) -> tuple[str, int]:
    """(sha256 heks, byte terbaca) dari fd yang sudah divalidasi; `on_tick` dipanggil tiap 64 MiB (detak jantung/pembatalan)."""
    digest = hashlib.sha256()
    total = since = 0
    while True:
        chunk = os.read(fd, MIB)
        if not chunk:
            return digest.hexdigest(), total
        digest.update(chunk)
        total += len(chunk)
        since += len(chunk)
        if on_tick is not None and since >= HASH_CHECK_EVERY:
            since = 0
            on_tick()


