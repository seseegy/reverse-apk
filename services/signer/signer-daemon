def kill_group(proc: subprocess.Popen) -> None:
    """SIGTERM ke seluruh process group, lalu SIGKILL bila belum berhenti."""
    for sig, wait in ((signal.SIGTERM, TERM_GRACE), (signal.SIGKILL, 5.0)):
        try:
            os.killpg(proc.pid, sig)
        except ProcessLookupError:
            return
        except PermissionError:
            pass
        deadline = time.monotonic() + wait
        while time.monotonic() < deadline:
            if proc.poll() is not None:
                return
            time.sleep(0.05)


def sweep_group(proc: subprocess.Popen) -> None:
    """Pastikan tak ada anak yang tertinggal setelah proses utama selesai."""
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass


class ToolResult(NamedTuple):
    rc: int | None          # kode keluar proses (None bila tidak pernah berjalan)
    out_bytes: bytes        # stdout (+stderr bila 'merge'): kepala 8 KiB + ekor 56 KiB
    err_text: str           # stderr terpisah (mode 'separate', maks 8 KiB) atau pesan galat spawn
    status: str             # done | timeout | cancelled | interrupted | output_limit | spawn_failed

    def text(self) -> str:
        return self.out_bytes.decode("utf-8", errors="replace")


class _Bounded:
    """Penampung keluaran terbatas: kepala + ekor; hitung total byte. Dikuras terus supaya alat tidak macet pada pipa penuh."""

    def __init__(self, head: int, tail: int) -> None:
        self.head_max, self.tail_max = head, tail
        self.head = bytearray()
        self.tail = bytearray()
        self.total = 0

    def feed(self, data: bytes) -> None:
        self.total += len(data)
        if len(self.head) < self.head_max:
            take = self.head_max - len(self.head)
            self.head += data[:take]
            data = data[take:]
        if data and self.tail_max:
            self.tail += data
            if len(self.tail) > self.tail_max:
                del self.tail[:len(self.tail) - self.tail_max]

    def value(self) -> bytes:
        if self.total > self.head_max + self.tail_max:
            return bytes(self.head) + b"\n[...dipotong...]\n" + bytes(self.tail)
        return bytes(self.head) + bytes(self.tail)


def _pump(fd: int, sink: _Bounded, over: threading.Event | None) -> None:
    try:
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                return
            sink.feed(chunk)
            if over is not None and sink.total > MAX_TOOL_OUTPUT:
                over.set()
    except OSError:
        return


def run_tool(argv: list[str], *, deadline: float, home: Any, on_tick: Callable[[], None], cancel_check: Callable[[], bool] | None = None,
             stderr: str = "merge") -> ToolResult:
    """Jalankan SATU alat (zipalign, apksigner, keytool) di process group sendiri. `deadline` = time.monotonic() absolut.
    Tiap 0,5 dtk: on_tick(), lalu STOP -> 'interrupted', cancel_check -> 'cancelled', tenggat -> 'timeout'; keluaran > 8 MiB -> 'output_limit'.
    Pada status selain 'done' seluruh grup sudah dimatikan."""
    home = Path(home)
    separate = stderr == "separate"
    try:
        os.makedirs(home, mode=0o700, exist_ok=True)
        proc = subprocess.Popen(
            argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE if separate else subprocess.STDOUT,
            start_new_session=True, close_fds=True, cwd=home, env=env_minimal(home),
        )
    except OSError as exc:
        return ToolResult(None, b"", f"{argv[0]} tidak dapat dijalankan ({errno.errorcode.get(exc.errno or 0, 'galat')})", "spawn_failed")
    over = threading.Event()
    out_sink, err_sink = _Bounded(HEAD_KEEP, TAIL_KEEP), _Bounded(ERR_KEEP, 0)
    readers = [threading.Thread(target=_pump, args=(proc.stdout.fileno(), out_sink, over), daemon=True)]
    if separate:
        readers.append(threading.Thread(target=_pump, args=(proc.stderr.fileno(), err_sink, None), daemon=True))
    for reader in readers:
        reader.start()
    status = "done"
    try:
        while True:
            try:
                proc.wait(timeout=TICK)
                break
            except subprocess.TimeoutExpired:
                pass
            on_tick()
            if STOP.is_set():
                status = "interrupted"
            elif cancel_check is not None and cancel_check():
                status = "cancelled"
            elif time.monotonic() > deadline:
                status = "timeout"
            elif over.is_set():
                status = "output_limit"
            if status != "done":
                kill_group(proc)
                break
        proc.wait()
        sweep_group(proc)
        for reader in readers:
            reader.join(timeout=5)
    finally:
        if proc.poll() is None:
            kill_group(proc)
            sweep_group(proc)
        for pipe in (proc.stdout, proc.stderr):
            if pipe is not None and not any(r.is_alive() for r in readers):
                try:
                    pipe.close()
                except OSError:
                    pass
    if status == "done" and over.is_set():
        status = "output_limit"
    return ToolResult(proc.returncode, out_sink.value(), err_sink.value().decode("utf-8", errors="replace"), status)


