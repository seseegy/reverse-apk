MIB = 1024 * 1024


def _int_env(name: str, default: int, lo: int, hi: int) -> int:
    """Bilangan bulat dari env, dijepit ke [lo, hi]; kosong atau tak valid -> `default`."""
    raw = os.environ.get(name, "").strip()
    try:
        value = int(raw)
    except ValueError:
        return default
    return max(lo, min(hi, value))


