def _io_failed(func: str, exc: OSError) -> None:
    """WARN SEKALI per (fungsi, errno), bukan tiap tick."""
    key = (func, exc.errno or 0)
    if key not in _WARNED:
        _WARNED.add(key)
        say(f"WARN {func} gagal ({errno.errorcode.get(exc.errno or 0, 'OSError')}); daemon tetap berjalan")


def _io_ok(func: str) -> None:
    gone = {k for k in _WARNED if k[0] == func}
    if gone:
        _WARNED.difference_update(gone)
        say(f"INFO {func} pulih")


class KeyInfo(NamedTuple):
    state: str              # ok | missing | unreadable | invalid | stale
    detail: str
    cert_sha256: str | None


KEY_STATE: dict[str, Any] = {"cache": None, "last": KeyInfo("invalid", "kunci belum diperiksa", None)}


def write_hb(state: str, job: str | None = None) -> None:
    """Tulis signer.hb sekarang (OSError ditelan: klien melihat signer usang, daemon tidak mati)."""
    key: KeyInfo = KEY_STATE["last"]
    HB.update(state=state, job=job, last=CLOCK(), sig=(state, job, key.state, key.cert_sha256))
    try:
        SPOOL.write_signer_heartbeat(state, job, {"state": key.state, "detail": scrub(key.detail), "cert_sha256": key.cert_sha256})
    except OSError as exc:
        _io_failed("write_signer_heartbeat", exc)
    else:
        _io_ok("write_signer_heartbeat")


def on_tick() -> None:
    """Dipanggil tiap 0,5 dtk; MENULIS hanya bila >= 5 dtk sejak tulis terakhir atau keadaan/job/kunci berubah (fsync mahal)."""
    key: KeyInfo = KEY_STATE["last"]
    changed = HB["sig"] != (HB["state"], HB["job"], key.state, key.cert_sha256)
    if changed or HB["last"] is None or CLOCK() - HB["last"] >= HEARTBEAT_EVERY:
        write_hb(HB["state"], HB["job"])


# ------------------------------------------------------------------ status kunci pemilik


def _signature(path: Path) -> tuple[int, ...] | None:
    try:
        fd = os.open(path, OPEN_FLAGS)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        return (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns)
    except OSError:
        return None
    finally:
        os.close(fd)


def key_status() -> KeyInfo:
    """Keadaan keystore pemilik; dipanggil saat start, sebelum tiap job, dan tiap <= 10 dtk saat idle. Tidak pernah melempar.

    Berkas diperiksa SETIAP kali (stale tak pernah dari cache). keytool hanya dijalankan bila tanda tangan (dev, ino, size, mtime_ns, ctime_ns) kedua
    berkas berubah; hanya hasil DEFINITIF yang di-cache (ok / invalid karena sandi atau alias). Hasil sementara (tenggat, EIO) tidak."""
    p12, pw = SECRETS_DIR / KS_NAME, SECRETS_DIR / PASS_NAME
    checks = [inspect_key_file(p12, kind="p12"), inspect_key_file(pw, kind="pass")]
    bad = [c for c in checks if c.state != "ok"]
    if bad:
        worst = min(bad, key=lambda c: _KEY_STATES.index(c.state) if c.state in _KEY_STATES else len(_KEY_STATES))
        info = KeyInfo(worst.state, worst.detail, None)
        KEY_STATE["last"] = info
        return info
    sig = (_signature(p12), _signature(pw))
    cache = KEY_STATE["cache"]
    if None not in sig and cache is not None and cache[0] == sig:
        KEY_STATE["last"] = cache[1]
        return cache[1]
    seen: dict[str, str] = {}

    def run(argv: list[str], *, deadline: float, home: Any, stderr: str) -> KeyToolResult:
        res = run_tool(argv, deadline=deadline, home=home, on_tick=on_tick, stderr=stderr)
        seen["status"] = res.status
        return KeyToolResult(res.rc if res.status == "done" else None, res.out_bytes, res.err_text)

    state, value = owner_fingerprint(p12, pw, run, home=str(TOOL_HOME_ROOT / "_key"), timeout=KEYTOOL_TIMEOUT)
    if state == "transient":
        if STOP.is_set() or seen.get("status") == "interrupted":
            return KEY_STATE["last"]          # dihentikan di tengah keytool: bukan 'invalid' palsu, cache tak tersentuh
        if seen.get("status") == "timeout":
            value = f"keytool tidak menjawab dalam {KEYTOOL_TIMEOUT:g} dtk (keystore di filesystem yang macet atau kehabisan memori?)"
        info = KeyInfo("invalid", value, None)           # sementara: TIDAK di-cache, dicoba lagi pada pemeriksaan berikut
        KEY_STATE["last"] = info
        return info
    info = KeyInfo("ok", "", value) if state == "ok" else KeyInfo("invalid", value, None)
    if None not in sig:
        KEY_STATE["cache"] = (sig, info)
    KEY_STATE["last"] = info
    return info


# ------------------------------------------------------------------ satu job


def _result(ok: bool, started: float, *, code: str | None = None, text: str = "", size: int = 0, sha: str | None = None, cert: str | None = None,
            verify: Verify | None = None, input_sha: str | None = None) -> dict[str, Any]:
    return {
        "ok": ok, "error_code": code, "error_text": text[:TEXT_MAX], "output_name": SIGNED, "output_size": size, "output_sha256": sha,
        "input_sha256": input_sha, "cert_sha256": cert, "verify": {"v1": verify.v1 if verify else None, "v2": bool(verify and verify.v2), "v3": bool(verify and verify.v3)},
        "signer_count": verify.signer_count if verify else None, "elapsed": round(time.monotonic() - started, 2),
    }


class _Job:
    def __init__(self, job_id: str) -> None:
        self.id = job_id
        self.aid = self.bid = 0
        self.bfd: int | None = None
        self.wfd: int | None = None          # fd akar signwork
        self.wname: str | None = None        # nama folder kerja job di signwork (= job id)
        self.home: Path | None = None
        self.size = 0
        self.last_cmd = ""


def _step(job: _Job, argv: list[str], deadline: float, code: str, timeout_s: int) -> ToolResult:
    """Satu alat dalam job; status non-'done' dan rc != 0 menjadi JobError dengan kode/teks yang sesuai."""
    assert job.home is not None
    if STOP.is_set():
        raise JobError("aborted", "signer dihentikan saat job berjalan")
    job.last_cmd = " ".join(redact_argv(argv))
    res = run_tool(argv, deadline=deadline, home=job.home, on_tick=on_tick, cancel_check=lambda: SPOOL.cancel_requested(job.id))
    if res.status == "interrupted":
        raise JobError("aborted", "signer dihentikan saat job berjalan")
    if res.status == "cancelled":
        raise JobError("cancelled", ERROR_TEXT["cancelled"])
    if res.status == "timeout":
        raise JobError("timeout", f"melebihi batas waktu {timeout_s} detik")
    if res.status == "output_limit":
        raise JobError("output_limit", ERROR_TEXT["output_limit"])
    if res.status == "spawn_failed":
        raise JobError("internal", scrub(res.err_text))
    if res.rc != 0:
        raise JobError(*map_tool_error(code, res.rc, res.text()))
    return res


def _guard(job: _Job) -> None:
    on_tick()
    if STOP.is_set():
        raise JobError("aborted", "signer dihentikan saat job berjalan")
    if SPOOL.cancel_requested(job.id):
        raise JobError("cancelled", ERROR_TEXT["cancelled"])


def _write_all(fd: int, data: bytes) -> None:
    view = memoryview(data)
    while view:
        view = view[os.write(fd, view):]


def copy_input(src_fd: int, wdfd: int, max_bytes: int, on_tick: Callable[[], None]) -> tuple[str, int]:
    """Salin `src_fd` (fd unsigned.apk yang SUDAH divalidasi) ke `in.apk` di ruang kerja privat sambil menghitung SHA-256. Mengembalikan (sha256, byte disalin):
    hash dihitung dari byte yang SUNGGUH disalin. Berkas yang tumbuh melewati `max_bytes` saat disalin -> input_too_large. `in.apk` dibuat O_EXCL|O_NOFOLLOW 0600."""
    out = os.open(W_IN, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=wdfd)
    digest = hashlib.sha256()
    total = since = 0
    try:
        while True:
            chunk = os.read(src_fd, MIB)
            if not chunk:
                break
            total += len(chunk)
            if total > max_bytes:
                raise JobError("input_too_large", f"{UNSIGNED} tumbuh melewati batas {max_bytes // MIB} MiB (SIGN_MAX_MB) saat disalin")
            digest.update(chunk)
            _write_all(out, chunk)
            since += len(chunk)
            if since >= HASH_CHECK_EVERY:
                since = 0
                on_tick()
    finally:
        os.close(out)
    return digest.hexdigest(), total


def _unlink_quiet(name: str, dir_fd: int) -> None:
    try:
        os.unlink(name, dir_fd=dir_fd)
    except OSError:
        pass


def publish_signed(bfd: int, signed_fd: int, sha: str, size: int, on_tick: Callable[[], None]) -> None:
    """Terbitkan hasil terverifikasi (fd di ruang kerja privat) ke folder build yang bisa ditulis runner, tahan balapan:
      * `.sign-signed.tmp` dibuat O_CREAT|O_EXCL|O_NOFOLLOW: nama yang sudah ada (ditanam penyerang: berkas, FIFO, symlink, direktori) -> EEXIST -> gagal-tertutup
        `internal`, TIDAK pernah menimpa atau mengikuti sasaran lain;
      * isi disalin dari fd yang sama sambil dihitung ulang (harus == `sha`), fsync, lalu `os.replace` (rename atomik; tidak mengikuti symlink; tujuan
        direktori berisi -> galat -> gagal);
      * BACA ULANG `signed.apk` dari folder build: berkas biasa, nlink==1, ukuran dan hash sama. Beda (ditukar dalam jendela signer) -> hapus + `internal`."""
    try:
        out = os.open(TMP_SIGNED, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644, dir_fd=bfd)
    except FileExistsError as exc:
        raise JobError("internal", f"{TMP_SIGNED} sudah ada di folder build (ditanam pihak lain?); penerbitan dibatalkan") from exc
    except OSError as exc:
        if exc.errno == errno.ELOOP:
            raise JobError("internal", f"{TMP_SIGNED} berupa symlink di folder build; penerbitan dibatalkan") from exc
        raise
    try:
        os.lseek(signed_fd, 0, os.SEEK_SET)
        digest = hashlib.sha256()
        total = since = 0
        while True:
            chunk = os.read(signed_fd, MIB)
            if not chunk:
                break
            digest.update(chunk)
            _write_all(out, chunk)
            total += len(chunk)
            since += len(chunk)
            if since >= HASH_CHECK_EVERY:
                since = 0
                on_tick()
        os.fsync(out)
    finally:
        os.close(out)
    if total != size or not hmac.compare_digest(digest.hexdigest(), sha):
        raise JobError("internal", "salinan terbit tidak sama dengan hasil yang diverifikasi")
    os.replace(TMP_SIGNED, SIGNED, src_dir_fd=bfd, dst_dir_fd=bfd)
    try:
        fd = os.open(SIGNED, OPEN_FLAGS, dir_fd=bfd)
    except OSError as exc:
        _unlink_quiet(SIGNED, bfd)                       # symlink/berkas aneh yang ditukar masuk: jangan dibiarkan bernama signed.apk
        raise JobError("internal", f"{SIGNED} tidak dapat dibaca ulang setelah diterbitkan ({errno.errorcode.get(exc.errno or 0, 'galat')})") from exc
    try:
        st = os.fstat(fd)
        again = None
        if stat.S_ISREG(st.st_mode) and st.st_nlink == 1 and st.st_size == size:
            again, _n = sha256_fd(fd, on_tick)
        if again is None or not hmac.compare_digest(again, sha):
            _unlink_quiet(SIGNED, bfd)
            raise JobError("internal", "keluaran berubah saat diterbitkan")
    finally:
        os.close(fd)


def _process(job: _Job, request: dict[str, Any], started: float) -> dict[str, Any]:
    try:
        job.aid, job.bid, req_timeout, expect_sha = validate_request(request, job.id)
    except ValueError as exc:
        raise JobError("bad_request", f"request tidak valid: {scrub(exc)}") from exc
    timeout_s = min(req_timeout, SIGN_TIMEOUT)
    deadline = time.monotonic() + timeout_s

    key = key_status()
    if key.state != "ok" or not key.cert_sha256:
        state = key.state if key.state != "ok" else "invalid"
        raise JobError(f"keystore_{state}", scrub(key.detail) or ERROR_TEXT[f"keystore_{state}"])
    owner = key.cert_sha256

    job.bfd = open_build_dir(job.aid, job.bid)
    # unsigned.apk dibuka SEKALI; fd ini dipegang sampai penyalinan selesai. Sesudah itu folder build milik runner TIDAK dibaca lagi untuk masukan.
    in_fd, job.size = open_input(job.bfd, UNSIGNED, SIGN_MAX_MB * MIB)
    try:
        job.home = TOOL_HOME_ROOT / job.id
        os.makedirs(job.home, mode=0o700, exist_ok=True)

        if sweep_leftovers(job.bfd):
            raise JobError("input_unsafe", "sisa berkas keluaran lama di folder build tidak bisa dihapus")
        job.wfd = open_signwork()
        free = _free(job.wfd)
        enough, need = check_disk(free, job.size)
        if not enough:
            raise JobError("no_space", f"signwork butuh {need // MIB} MiB, bebas {free // MIB} MiB (2x ukuran APK + 16 MiB + cadangan 1 GiB)")
        free = _free(job.bfd)
        enough, need = check_disk_builds(free, job.size)
        if not enough:
            raise JobError("no_space", f"builds butuh {need // MIB} MiB, bebas {free // MIB} MiB (1x ukuran APK + 16 MiB + cadangan 1 GiB)")

        job.wname = job.id
        cleanup_work_dir(job.wfd, job.wname)                  # id job unik; sisa (mustahil) dibuang dulu
        os.mkdir(job.wname, 0o700, dir_fd=job.wfd)
        wdfd = os.open(job.wname, DIR_FLAGS, dir_fd=job.wfd)
        try:
            input_sha, _copied = copy_input(in_fd, wdfd, SIGN_MAX_MB * MIB, lambda: _guard(job))
            # A-02: berkas yang ditukar sejak runner selesai ditolak SEBELUM alat apa pun dijalankan.
            if not hmac.compare_digest(input_sha, expect_sha):
                raise JobError("input_unsafe", "unsigned.apk berubah sejak build selesai (hash tak cocok)")
            os.close(in_fd)
            in_fd = -1
            wdir = LAYOUT.signwork / job.wname
            src, aligned, signed = wdir / W_IN, wdir / W_ALIGNED, wdir / W_SIGNED
            _step(job, build_zipalign_cmd(src, aligned), deadline, "align_failed", timeout_s)
            _step(job, build_zipalign_check_cmd(aligned), deadline, "align_failed", timeout_s)
            os.unlink(W_IN, dir_fd=wdfd)
            try:
                _step(job, build_sign_cmd(aligned, signed), deadline, "sign_failed", timeout_s)
            finally:
                try:
                    os.unlink(W_ALIGNED, dir_fd=wdfd)
                except OSError:
                    pass
            res = _step(job, build_verify_cmd(signed), deadline, "verify_failed", timeout_s)
            verify = parse_verify(res.rc, res.text())
            ok, code, text = evaluate_verify(verify, owner)
            if not ok:
                raise JobError(code or "verify_failed", text)

            # Folder kerja privat: tidak ada pihak lain yang bisa menukar signed.apk di sini (tetap divalidasi dari fd).
            fd = os.open(W_SIGNED, OPEN_FLAGS, dir_fd=wdfd)
            try:
                st = os.fstat(fd)
                if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
                    raise JobError("input_unsafe", f"{W_SIGNED} bukan berkas biasa sehingga tidak diterbitkan")
                sha, size = sha256_fd(fd, lambda: _guard(job))
                if size <= 0:
                    raise JobError("verify_failed", "keluaran tanda tangan kosong")
                publish_signed(job.bfd, fd, sha, size, lambda: _guard(job))
            finally:
                os.close(fd)
        finally:
            os.close(wdfd)
    finally:
        if in_fd >= 0:
            os.close(in_fd)
    return _result(True, started, size=size, sha=sha, cert=verify.digests[0], verify=verify, input_sha=input_sha)


def _free(fd: int) -> int:
    """Byte bebas pada filesystem yang memuat `fd`."""
    st = os.statvfs(fd)
    return st.f_bavail * st.f_frsize


def finish_with_retry(job_id: str, result: dict[str, Any], bfd: int | None = None, home: Any = None, work: tuple[int | None, str | None] = (None, None)) -> bool:
    """Spool.finish dengan 3 percobaan (jeda 1 dtk, pembersihan ulang tiap gagal). Tetap gagal -> hasil minimal; itupun gagal -> hanya log ERROR
    (request tetap di running/ dan dijawab 'aborted' saat start berikut). Tidak pernah melempar."""
    last: BaseException | None = None
    for attempt in range(FINISH_ATTEMPTS):
        try:
            SPOOL.finish(job_id, result)
            return True
        except Exception as exc:  # noqa: BLE001 - daemon tidak boleh mati karena satu hasil gagal ditulis
            last = exc
            say(f"[{job_id}] WARN finish gagal percobaan {attempt + 1}/{FINISH_ATTEMPTS} ({type(exc).__name__})")
            cleanup_job_files(bfd, home)
            cleanup_work_dir(*work)
            if attempt + 1 < FINISH_ATTEMPTS:
                time.sleep(FINISH_RETRY_DELAY)
    code = "no_space" if isinstance(last, OSError) and last.errno == errno.ENOSPC else "internal"
    try:
        SPOOL.finish(job_id, _result(False, time.monotonic(), code=code, text=ERROR_TEXT[code]))
        return True
    except Exception as exc:  # noqa: BLE001
        say(f"[{job_id}] ERROR hasil tidak bisa ditulis ({type(exc).__name__}); request dibiarkan di running/ (aborted saat start berikut)")
        return False


def run_job(job_id: str, request: dict[str, Any]) -> dict[str, Any]:
    """Proses satu job SAMPAI hasil terkirim (Spool.finish) dan kembalikan hasilnya. Pembersihan berjalan SEBELUM finish."""
    started = time.monotonic()
    job = _Job(job_id)
    try:
        try:
            result = _process(job, request, started)
        except JobError as exc:
            result = _result(False, started, code=exc.code, text=exc.text)
        except OSError as exc:
            code = "no_space" if exc.errno == errno.ENOSPC else "internal"
            result = _result(False, started, code=code, text=ERROR_TEXT[code] if code == "no_space" else f"galat I/O signer: {errno.errorcode.get(exc.errno or 0, 'OSError')}")
        except Exception as exc:  # noqa: BLE001 - satu job buruk tak boleh mematikan daemon
            say(f"[{job_id}] ERROR galat internal: {type(exc).__name__}")
            result = _result(False, started, code="internal", text=f"galat internal signer: {type(exc).__name__}")
        cleanup_job_files(job.bfd, job.home)
        cleanup_work_dir(job.wfd, job.wname)
        finish_with_retry(job_id, result, job.bfd, job.home, (job.wfd, job.wname))
        say(f"[{job_id}] aid={job.aid} bid={job.bid} {'ok' if result['ok'] else result['error_code']} ukuran={result['output_size']} {result['elapsed']}s"
            + ("" if result["ok"] or not job.last_cmd else f" langkah={job.last_cmd}"))
        return result
    finally:
        cleanup_job_files(job.bfd, job.home)
        cleanup_work_dir(job.wfd, job.wname)
        for fd in (job.bfd, job.wfd):
            if fd is not None:
                try:
                    os.close(fd)
                except OSError:
                    pass


# ------------------------------------------------------------------ siklus daemon


def clear_signwork() -> None:
    """Kosongkan SELURUH isi `signwork` saat start: hanya signer yang memakai volume ini dan tidak ada job berjalan saat daemon naik, jadi semua isinya sisa."""
    try:
        wfd = os.open(LAYOUT.signwork, DIR_FLAGS)
    except FileNotFoundError:
        return
    except OSError as exc:
        _io_failed("clear_signwork", exc)
        return
    try:
        for name in os.listdir(wfd):
            try:
                rmtree_at(wfd, name)
            except OSError as exc:
                _io_failed("clear_signwork", exc)
    finally:
        os.close(wfd)


def abort_orphans() -> None:
    """Job yang tercatat 'running' tetapi prosesnya hilang dijawab 'aborted'; signed.apk + .sign-* + *.idsig di folder build-nya dihapus.
    Seluruh isi `signwork` (ruang kerja privat job yang mati) ikut dikosongkan."""
    clear_signwork()
    for job_id in SPOOL.running_job_ids():
        m = JOB_ID_RE.match(job_id)
        if m is not None:
            try:
                bfd = open_build_dir(int(m.group(1)), int(m.group(2)))
            except (JobError, ValueError, OSError):
                bfd = None
            if bfd is not None:
                try:
                    sweep_leftovers(bfd)
                except OSError as exc:
                    _io_failed("abort_orphans", exc)
                os.close(bfd)
        say(f"[{job_id}] yatim dari proses sebelumnya -> aborted")
        try:
            SPOOL.finish(job_id, _result(False, time.monotonic(), code="aborted", text="signer dimulai ulang saat job berjalan"))
        except OSError as exc:
            _io_failed("abort_orphans", exc)


def housekeeping() -> None:
    """Buang hasil/flag batal yang tak pernah dikonsumsi (> 1 jam). OSError ditelan dengan WARN sekali."""
    cutoff = time.time() - STALE_FILE_SECONDS
    try:
        for directory in (SPOOL.results, SPOOL.cancel):
            with os.scandir(directory) as it:
                for entry in it:
                    try:
                        if entry.stat(follow_symlinks=False).st_mtime < cutoff:
                            os.unlink(entry.path)
                    except OSError:
                        pass
    except OSError as exc:
        _io_failed("housekeeping", exc)
    else:
        _io_ok("housekeeping")


def health() -> int:
    """0 bila signer.hb <= 20 dtk DAN keystore.state == ok; selain itu 1 dengan SATU baris alasan di stdout."""
    status = signer_status(SPOOL)
    age = status["umur"]
    if age is None or age > HEALTH_MAX_AGE:
        print("signer.hb tidak ada atau usang" + (f" (umur {age:.0f} dtk)" if age is not None else ""))
        return 1
    ks = status["keystore"]
    if ks["state"] != "ok":
        print(f"keystore {ks['state'] or 'tidak diketahui'}: {ks['detail']}".strip())
        return 1
    return 0


def _log_key_change(info: KeyInfo, previous: KeyInfo | None) -> None:
    if previous is None or (previous.state, previous.cert_sha256) != (info.state, info.cert_sha256):
        say(("INFO keystore ok (sidik jari " + (info.cert_sha256 or "")[:12] + "…)") if info.state == "ok"
            else f"WARN keystore {info.state}: {scrub(info.detail)}")


def main() -> int:
    if "--health" in sys.argv:
        return health()

    os.umask(0o022)
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: STOP.set())

    TOOL_HOME_ROOT.mkdir(parents=True, exist_ok=True)
    key_home = TOOL_HOME_ROOT / "_key"
    key_home.mkdir(parents=True, exist_ok=True)
    os.chmod(key_home, 0o700)
    SPOOL.ensure_dirs()
    abort_orphans()
    housekeeping()
    info = key_status()
    _log_key_change(info, None)
    HB.update(state="idle", job=None)
    write_hb("idle")
    say(f"signer siap (uid={os.getuid()}, batas {SIGN_MAX_MB} MiB, tenggat {SIGN_TIMEOUT}s)")

    last_key = last_house = time.monotonic()
    while not STOP.is_set():
        try:
            claimed = SPOOL.claim_next()
        except OSError as exc:
            _io_failed("claim_next", exc)
            claimed = None
        if claimed:
            job_id, request = claimed
            HB.update(state="busy", job=job_id)
            write_hb("busy", job_id)
            run_job(job_id, request)
            HB.update(state="idle", job=None)
            write_hb("idle")
            last_key = time.monotonic()
            continue

        now = time.monotonic()
        if now - last_key >= KEY_RECHECK:
            previous, info = info, key_status()
            _log_key_change(info, previous)
            last_key = time.monotonic()
        on_tick()
        if now - last_house >= HOUSEKEEP_EVERY:
            housekeeping()
            last_house = now
        STOP.wait(TICK)
    say("berhenti")
    return 0


if __name__ == "__main__":
    sys.exit(main())
