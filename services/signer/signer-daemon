class JobError(Exception):
    """Kegagalan terduga satu job: `code` (salah satu ERROR_CODES) dan `text` (satu kalimat Indonesia, sudah disaring)."""

    def __init__(self, code: str, text: str) -> None:
        super().__init__(f"{code}: {text}")
        self.code = code
        self.text = text


