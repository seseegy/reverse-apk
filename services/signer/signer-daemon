def env_minimal(home: Any) -> dict[str, str]:
    """Environment alat: HANYA PATH, HOME, LANG. os.environ daemon tidak diteruskan (tak ada rahasia/JAVA_TOOL_OPTIONS yang ikut)."""
    return {"PATH": TOOL_PATH, "HOME": str(home), "LANG": "C.UTF-8"}


def scrub(text: Any, extra: tuple[str, ...] | list[str] = ()) -> str:
    """Teks aman untuk log/hasil: buang karakter kontrol, samarkan jalur rahasia/build dan isi `extra`, potong 300 karakter."""
    clean = "".join(" " if ch in "\t\r\n" else ch for ch in str(text) if ch in "\t\r\n" or ch.isprintable())
    for secret in extra:
        if secret:
            clean = clean.replace(secret, "<rahasia>")
    clean = re.sub(re.escape(str(SECRETS_DIR)) + r"(?:/\S*)?", "<rahasia>", clean)
    clean = re.sub(re.escape(str(LAYOUT.root)) + r"(?:/\S*)?", "<build>", clean)
    return clean.strip()[:TEXT_MAX]


def last_error_line(text: str) -> str | None:
    """Satu baris galat terakhir (tanpa bingkai stack trace '\tat …' / '… N more')."""
    for line in reversed(text.splitlines()):
        line = line.strip()
        if line and not line.startswith(("at ", "...")) and _ERROR_LINE.search(line):
            return line
    return None


def map_tool_error(code: str, rc: int | None, text: str, extra: tuple[str, ...] | list[str] = ()) -> tuple[str, str]:
    """(error_code, error_text) untuk alat yang selesai dengan rc != 0 (BUKAN dibunuh oleh kita). `code` = kode bawaan tahap itu.

    Stack trace JVM tidak diteruskan: hanya teks tetap, atau SATU baris galat terakhir yang sudah disaring."""
    if "keystore password was incorrect" in text or "does not contain a key" in text:
        return "keystore_invalid", ERROR_TEXT["keystore_invalid"]
    if "No space left on device" in text:
        return "no_space", ERROR_TEXT["no_space"]
    if "OutOfMemoryError: Direct buffer memory" in text:
        return code, "memori langsung JVM habis; lihat docs/deploy.md (batas -XX:MaxDirectMemorySize)"
    if "OutOfMemoryError: Java heap space" in text:
        return code, "memori heap JVM habis (-Xmx256m); lihat docs/deploy.md"
    if rc in (137, -9):
        return code, "alat dimatikan (kemungkinan kehabisan memori 512m; lihat docs/deploy.md)"
    if "MinSdkVersionException" in text or "malformed binary resource" in text:
        return code, "APK tidak valid (AndroidManifest.xml tidak terbaca)"
    if re.search(r"Unable to open .* as zip archive", text):
        return code, "bukan berkas ZIP/APK yang valid"
    line = last_error_line(text)
    return code, scrub(line, extra) if line else ERROR_TEXT[code]


def check_disk(free: int, size: int) -> tuple[bool, int]:
    """(cukup, dibutuhkan) untuk volume `signwork`. Puncak = in.apk + aligned.apk, lalu aligned.apk + signed.apk (in.apk dihapus setelah zipalign)
    ~ 2x ukuran + blok tanda tangan + cadangan."""
    need = 2 * size + SIG_SLACK + RESERVE
    return free >= need, need


def check_disk_builds(free: int, size: int) -> tuple[bool, int]:
    """(cukup, dibutuhkan) untuk volume `builds`: salinan terbit (`.sign-signed.tmp` -> signed.apk) = 1x ukuran + blok tanda tangan + cadangan."""
    need = size + SIG_SLACK + RESERVE
    return free >= need, need


def open_build_dir(analysis_id: int, build_id: int) -> int:
    """fd folder build lewat rantai builds -> <aid> -> <bid> (`fsutil.open_dir_chain`: O_DIRECTORY|O_NOFOLLOW relatif dir_fd). Id non-int ditolak Layout
    (ValueError). SEMUA operasi berkas signer pada folder itu sesudahnya memakai fd ini, jadi symlink yang diselipkan di komponen perantara tidak diikuti."""
    LAYOUT.build_dir(analysis_id, build_id)
    try:
        return open_dir_chain(LAYOUT.builds, str(analysis_id), str(build_id))
    except OSError as exc:
        if exc.errno == errno.ENOENT:
            raise JobError("input_missing", f"folder build {analysis_id}/{build_id} tidak ditemukan") from exc
        if exc.errno in (errno.ELOOP, errno.ENOTDIR):
            raise JobError("input_unsafe", "folder build bukan direktori biasa (symlink atau jenis lain) sehingga ditolak") from exc
        raise JobError("internal", f"folder build tidak bisa dibuka ({errno.errorcode.get(exc.errno or 0, 'galat')})") from exc


def open_signwork() -> int:
    """fd akar ruang kerja privat `signwork` (dibuat bila belum ada; volume ini HANYA dipasang ke signer)."""
    try:
        os.makedirs(LAYOUT.signwork, mode=0o700, exist_ok=True)
        return os.open(LAYOUT.signwork, DIR_FLAGS)
    except OSError as exc:
        raise JobError("internal", f"ruang kerja signwork tidak bisa dibuka ({errno.errorcode.get(exc.errno or 0, 'galat')})") from exc


def open_input(bfd: int, name: str, max_bytes: int) -> tuple[int, int]:
    """Buka masukan tak tepercaya relatif ke `bfd` -> (fd, ukuran). Tidak pernah menggantung pada FIFO (OPEN_FLAGS memuat O_NONBLOCK)."""
    try:
        fd = os.open(name, OPEN_FLAGS, dir_fd=bfd)
    except FileNotFoundError as exc:
        raise JobError("input_missing", f"{name} tidak ditemukan untuk build ini") from exc
    except OSError as exc:
        if exc.errno in (errno.ELOOP, errno.ENXIO, errno.EISDIR, errno.ENOTDIR):
            raise JobError("input_unsafe", f"{name} bukan berkas biasa (symlink atau jenis lain) sehingga ditolak") from exc
        raise JobError("internal", f"{name} tidak bisa dibuka ({errno.errorcode.get(exc.errno or 0, 'galat')})") from exc
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise JobError("input_unsafe", f"{name} bukan berkas biasa sehingga ditolak")
        if st.st_nlink != 1:
            raise JobError("input_unsafe", f"{name} punya tautan keras lain (nlink={st.st_nlink}) sehingga ditolak")
        if st.st_size <= 0:
            raise JobError("input_unsafe", f"{name} kosong (0 byte)")
        if st.st_size > max_bytes:
            raise JobError("input_too_large", f"{name} berukuran {st.st_size / MIB:.1f} MiB, melebihi batas {max_bytes // MIB} MiB (SIGN_MAX_MB)")
        return fd, st.st_size
    except BaseException:
        os.close(fd)
        raise


def _is_leftover(name: str) -> bool:
    return name == SIGNED or name.startswith(".sign-") or name.endswith(".idsig")


def sweep_leftovers(bfd: int, *, signed: bool = True) -> list[str]:
    """Hapus signed.apk (bila `signed`), setiap .sign-* dan *.idsig di folder build (unlink dir_fd: tidak mengikuti symlink). IDEMPOTEN.
    Mengembalikan nama yang TIDAK bisa dihapus (mis. direktori); OSError dari listdir naik ke pemanggil."""
    stuck: list[str] = []
    for name in os.listdir(bfd):
        if not _is_leftover(name) or (name == SIGNED and not signed):
            continue
        try:
            os.unlink(name, dir_fd=bfd)
        except FileNotFoundError:
            pass
        except OSError:
            stuck.append(name)
    return stuck


def cleanup_job_files(bfd: int | None, home: Any = None) -> bool:
    """Pembersihan IDEMPOTEN yang tidak pernah melempar: sisa .sign-*/*.idsig di folder build + HOME job. True bila bersih.
    signed.apk SENGAJA tidak disentuh (itu hasil job yang sukses); hanya sweep_leftovers() awal job dan pemulihan yatim yang membuangnya."""
    clean = True
    if bfd is not None:
        try:
            clean = not sweep_leftovers(bfd, signed=False)
        except OSError:
            clean = False
    if home is not None:
        try:
            safe_rmtree(home)
        except OSError:
            clean = False
    return clean


def cleanup_work_dir(wfd: int | None, name: str | None) -> bool:
    """Hapus `signwork/<job>` (salinan masukan, aligned, signed) tanpa mengikuti symlink. IDEMPOTEN, tidak pernah melempar. True bila bersih."""
    if wfd is None or name is None:
        return True
    try:
        rmtree_at(wfd, name)
    except OSError:
        return False
    return True


