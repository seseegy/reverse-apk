{
	# Matikan admin API (tidak dipakai). Konsekuensi: ubah Caddyfile -> `docker compose restart caddy`.
	admin off
}

# Reverse proxy ke aplikasi web. Caddy menimpa X-Forwarded-* dari klien,
# jadi IP klien yang diteruskan ke aplikasi tidak bisa dipalsukan.
(app_proxy) {
	reverse_proxy web:8000 {
		health_uri /healthz
		health_interval 5s
		# Saat web restart, tahan request sebentar dan coba ulang alih-alih langsung 503.
		lb_try_duration 15s
		lb_try_interval 250ms
		# Aliran SSE (status live) harus diteruskan seketika, tanpa buffer.
		flush_interval -1
	}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Upload APK: satu-satunya rute dengan body besar. Batas ini sama dengan MAX_UPLOAD_MB di aplikasi
	# (aplikasi yang memberi pesan galat jelas; ini sabuk pengaman di tepi).
	# Catatan: bila Cloudflare proxy (awan oranye) menyala, paket gratis membatasi body ~100 MB.
	handle /api/uploads {
		request_body {
			max_size {$MAX_UPLOAD_MB}MiB
		}
		import app_proxy
	}

	# Semua rute lain: body kecil.
	handle {
		request_body {
			max_size 1MB
		}
		import app_proxy
	}

	log {
		output stdout
		format console
	}
}
